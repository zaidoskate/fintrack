                      }}
                      title="Adelantar mensualidades"
                      style={{
                        background: 'rgba(255,255,255,0.06)',
                        border: 'none',
                        borderRadius: '6px',
                        padding: '6px',
                        color: 'var(--text-primary)',
                        cursor: 'pointer',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'center'
                      }}
                    >
                      <FastForward size={16} />
                    </button>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      {/* Sección Metas expandible (Débito) */}
      {!esCredito && variant === 'full' && desgloseMetas.length > 0 && (
        <div style={{ marginTop: '14px' }}>
          <button
            onClick={(e) => { e.stopPropagation(); setMetasOpen((v) => !v); }}
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: '6px',
              background: 'none',
              border: 'none',
              color: 'var(--text-secondary)',
              fontSize: '12px',
              cursor: 'pointer',
              padding: 0,
            }}
          >
            <span style={{
              display: 'inline-block',
              transform: metasOpen ? 'rotate(90deg)' : 'rotate(0deg)',
              transition: 'transform 0.2s ease',
            }}>▶</span>
            {fmt.format(totalAportado)} aportados a metas
          </button>

          {metasOpen && (
            <div style={{ marginTop: '10px', display: 'flex', flexDirection: 'column', gap: '8px' }}>
              {desgloseMetas.map((m) => (
                <div
                  key={m.id}
                  style={{
                    background: 'rgba(255,255,255,0.04)',
                    border: '1px solid rgba(255,255,255,0.08)',
                    borderRadius: '12px',
                    padding: '10px 14px',
                    display: 'flex',
                    justifyContent: 'space-between',
                    alignItems: 'center',
                  }}
                >
                  <div style={{ fontSize: '13px', color: 'var(--text-primary)', fontWeight: 500 }}>
                    {m.metaNombre}
                  </div>
                  <div style={{
                    fontFamily: 'var(--font-mono)',
                    fontWeight: 700,
                    fontSize: '15px',
                    color: 'var(--credito-verde)',
                    textAlign: 'right',
                  }}>
                    {fmt.format(m.monto)}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      {/* Sección Apartados expandible (Débito) */}
      {!esCredito && variant === 'full' && (
        <div style={{ marginTop: '14px' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            {apartados.length > 0 ? (
              <button
                onClick={(e) => { e.stopPropagation(); setApartadosOpen((v) => !v); }}
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: '6px',
                  background: 'none',
                  border: 'none',
                  color: 'var(--text-secondary)',
                  fontSize: '12px',
                  cursor: 'pointer',
                  padding: 0,
                }}
              >
                <span style={{
                  display: 'inline-block',
                  transform: apartadosOpen ? 'rotate(90deg)' : 'rotate(0deg)',
                  transition: 'transform 0.2s ease',
                }}>▶</span>
                {apartados.length} Apartado{apartados.length !== 1 ? 's' : ''} con rendimiento
              </button>
            ) : (
              <span style={{ fontSize: '12px', color: 'var(--text-muted)' }}>Sin apartados</span>
            )}
            
            {onAddApartado && (
              <button
                onClick={(e) => { e.stopPropagation(); onAddApartado(tarjeta); }}
