<file path="src/lib/types.ts">
/**
 * Tipos compartidos de dominio financiero.
 * Implementa: API_Contract.md v2.0 (interfaces TypeScript de §1–4).
 * agents.md: toda comunicación con Supabase pasa por lib/api/ o lib/finance/.
 */

// ── Tablas de Supabase (snake_case, reflejan el esquema) ─────────────────────

export interface TarjetaRow {
  id: string;
  user_id: string;
  nombre: string;
  tipo: 'Crédito' | 'Débito';
  limite: number;       // Para Débito esto es el Saldo Inicial
  dia_corte: number | null;
  dia_pago: number | null;
  rendimiento_anual: number; // Solo para Débito
  balance_actual: number | null; // Calculado por DB trigger (solo Débito)
  gasto_inicial_ciclo?: number; // Para calibración de ciclo en Crédito
  created_at: string;
}

export interface MovimientoRow {
  id: string;
  user_id: string;
  fecha: string;        // YYYY-MM-DD
  hora: string;         // HH:MM:SS
  tipo: 'Gasto' | 'Ingreso';
  monto: number;
  categoria: string;
  comercio: string;
  tarjeta_id: string | null;
  tarjetas?: { nombre: string } | null;
  created_at: string;
}

export interface MetaRow {
  id: string;
  user_id: string;
  nombre: string;
  costo_objetivo: number;
  fecha_objetivo?: string; // YYYY-MM-DD
  created_at: string;
}

export interface MetaAporteRow {
  id: string;
  user_id: string;
  meta_id: string;
  monto: number;
  fecha: string;
  tarjeta_origen_id: string | null;
  apartado_id: string | null;
  created_at: string;
}

export interface CompraMSIRow {
  id: string;
  user_id: string;
  tarjeta_id: string;
  fecha_compra: string;
  comercio: string;
  categoria: string;
  monto_total: number;
  meses_totales: number;
  cuota_mensual: number;  // campo generado por PostgreSQL
  fecha_primer_cargo: string;
  fecha_ultima_cuota: string;
  meses_adelantados: number;
  descuento_por_adelanto: number;
  created_at: string;
}

export interface PortafolioActivoRow {
  id: string;
  user_id: string;
  simbolo: string;
  tipo: 'crypto' | 'stock' | 'etf';
  cantidad: number;
  inversion_inicial: number;
  created_at: string;
}

export interface CuentaYieldRow {
  id: string;
  user_id: string;
  nombre: string;
  moneda: 'MXN' | 'USD' | 'USDC' | 'USDT';
  balance_inicial: number;
  interes_acumulado: number;
  apy: number;
  ultima_actualizacion: string; // YYYY-MM-DD
  created_at: string;
}

export interface ApartadoRow {
  id: string;
  user_id: string;
  tarjeta_id: string;
  nombre: string;
  rendimiento_anual: number;
  balance_inicial: number;
  interes_acumulado: number;
  ultima_actualizacion: string; // YYYY-MM-DD
  created_at: string;
}

// ── Tipos de dominio (camelCase, para la UI y lib/finance/) ──────────────────

/** Estado calculado de una tarjeta (Architecture.md §5) */
export interface TarjetaConEstado {
  id: string;
  nombre: string;
  tipo: 'Crédito' | 'Débito';
  limite: number;        // Límite o Saldo inicial
  diaCorte: number | null;
  diaPago: number | null;
  rendimientoAnual: number; // TNA % para Débito
  gastoInicialCiclo?: number;
  gastosPeriodoActual: number;
  disponible: number;    // Límite disponible (Crédito) o Saldo actual (Débito)
  porcentajeUso: number; // 0 para Débito
  estadoTermometro: 'verde' | 'amarillo' | 'rojo'; // 'verde' para Débito siempre
  etiquetaEstado: string;
  proximoCorte: string | null;  // YYYY-MM-DD
  proximoPago: string | null;   // YYYY-MM-DD
  diasParaPago: number | null;
  apartados?: ApartadoConEstado[];
}

/** Estado de un apartado (Cajita) calculado con rendimientos al día de hoy */
export interface ApartadoConEstado {
  id: string;
  tarjetaId: string;
  nombre: string;
  rendimientoAnual: number; // TNA %
  balanceInicial: number;   // Balance original depositado
  interesAcumulado: number;
  balanceCalculado: number; // Balance + Rendimientos
  ultimaActualizacion: string;
}

/** Movimiento normalizado para la UI */
export interface Movimiento {
  id: string;
  fecha: string;
  hora: string;
  tipo: 'Gasto' | 'Ingreso';
  monto: number;
  categoria: string;
  comercio: string;
  metodoPago: string;
}

/** Meta con progreso y proyección calculados */
export interface MetaConEstado {
  id: string;
  nombre: string;
  costoObjetivo: number;
  fechaObjetivo?: string;
  montoActual: number;      // Calculado sumando aportes + rendimientos
  capitalAportado: number;  // Suma neta de aportes
  rendimientoGenerado: number; // Suma de rendimientos
  progreso: number;         // porcentaje 0–100
  aportes: MetaAporte[];
  proyeccion: {
    aportesMensualesPromedio: number;
    mesesEstimadosSinRendimiento: number | null;
    mesesEstimadosConRendimiento: number | null;
    fechaEstimadaCumplimiento: string | null;  // YYYY-MM-DD
  };
}

export interface MetaAporte {
  id: string;
  metaId: string;
  monto: number;
  fecha: string;
  tarjetaOrigenId: string | null;
  tarjetaOrigenNombre?: string;
  apartadoId: string | null;
  apartadoNombre?: string;
  rendimientoGenerado: number; // Rendimiento individual de este aporte hasta hoy
}

/** Compra MSI con meses restantes calculados */
export interface CompraMSI {
  id: string;
  tarjetaId: string;
  fechaCompra: string;
  comercio: string;
  categoria: string;
  montoTotal: number;
  mesesTotales: number;
  cuotaMensual: number;
  fechaPrimerCargo: string;
  fechaUltimaCuota: string;
  mesesAdelantados: number;
  descuentoPorAdelanto: number;
  mesesRestantes: number;  // calculado en cliente
}

export interface PortafolioActivo {
  id: string;
  simbolo: string;
  tipo: 'crypto' | 'stock' | 'etf';
  cantidad: number;
  inversionInicial: number;
  precioActual?: number; // Fetcheado desde API
  valorTotal?: number;   // cantidad * precioActual
}

export interface CuentaYield {
  id: string;
  nombre: string;
  moneda: 'MXN' | 'USD' | 'USDC' | 'USDT';
  balanceInicial: number;
  interesAcumulado: number;
  apy: number;
  ultimaActualizacion: string;
  balanceActual: number; // Proyectado al día de hoy en su moneda original
  valorTotalMXN?: number; // Calculado al tipo de cambio
}

// ── Parámetros de filtro ─────────────────────────────────────────────────────

export interface FiltrosMovimientos {
  desde?: string;   // YYYY-MM-DD
  hasta?: string;   // YYYY-MM-DD
  tipo?: 'Gasto' | 'Ingreso';
  tarjetaId?: string;
  limit?: number;
  offset?: number;
}

export const CATEGORIAS_TRANSFERENCIA = ['Pago de tarjeta', 'Traspaso', 'Ajuste de balance'] as const;

export const esGastoReal = (m: { tipo: string; categoria?: string }) => 
  m.tipo === 'Gasto' && m.categoria && !(CATEGORIAS_TRANSFERENCIA as readonly string[]).includes(m.categoria);
</file>

<file path="src/components/dashboard/MovimientosTarjetaModal.tsx">
'use client';

import { motion, AnimatePresence } from 'motion/react';
import { useMotionConfig } from '@/lib/motion/variants';
import { GlassCard, Loader, ConfirmModal } from '@/components/ui';
import { useMovimientosPaginados, useCrearMovimiento, useEliminarMovimiento } from '@/lib/hooks';
import type { TarjetaConEstado, Movimiento } from '@/lib/types';
import { useState, useMemo, useEffect } from 'react';
import { createPortal } from 'react-dom';
import { Edit2, Trash2, Search } from 'lucide-react';
import { RegistroForm } from './RegistroForm';

const fmt = new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: 'MXN',
  minimumFractionDigits: 0,
  maximumFractionDigits: 2,
});

function fmtFecha(iso: string): string {
  const [y, m, d] = iso.split('-');
  return `${d}/${m}/${y}`;
}

interface MovimientosTarjetaModalProps {
  tarjeta: TarjetaConEstado | null;
  onClose: () => void;
}

export function MovimientosTarjetaModal({ tarjeta, onClose }: MovimientosTarjetaModalProps) {
  const [mounted, setMounted] = useState(false);
  const { modalTransition } = useMotionConfig();
  const { 
    data, 
    isLoading, 
    fetchNextPage, 
    hasNextPage, 
    isFetchingNextPage 
  } = useMovimientosPaginados(
    tarjeta ? { tarjetaId: tarjeta.id } : undefined
  );
  
  const movimientos = useMemo(() => data ? data.pages.flat() : [], [data]);
  
  const { mutate: crearMovimiento, isPending } = useCrearMovimiento();
  const { mutate: eliminarMov } = useEliminarMovimiento();
  const [payMode, setPayMode] = useState(false);
  const [payAmount, setPayAmount] = useState('');
  const [editingMov, setEditingMov] = useState<Movimiento | null>(null);
  const [movToDelete, setMovToDelete] = useState<string | null>(null);
  const [searchTerm, setSearchTerm] = useState('');

  useEffect(() => {
    // eslint-disable-next-line react-hooks/set-state-in-effect
    setMounted(true);
  }, []);

  const handlePaySubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!tarjeta) return;
    crearMovimiento({
      fecha: new Date().toISOString().substring(0, 10),
      tipo: 'Ingreso',
      monto: parseFloat(payAmount),
      tarjetaId: tarjeta.id,
      categoria: 'Pago de tarjeta',
      comercio: 'Pago',
    }, {
      onSuccess: () => {
        setPayMode(false);
        setPayAmount('');
      }
    });
  };

  // Filtrar y Agrupar
  const grouped = useMemo(() => {
    if (!movimientos || !Array.isArray(movimientos)) return {};

    const safeSearch = (searchTerm || '').toLowerCase();
    
    const filtered = movimientos.filter(m => {
      if (!safeSearch) return true;
      const comercio = String(m.comercio || '').toLowerCase();
      const categoria = String(m.categoria || '').toLowerCase();
      const montoStr = String(m.monto || 0);
      return comercio.includes(safeSearch) || categoria.includes(safeSearch) || montoStr.includes(safeSearch);
    });
    
    const groups: Record<string, Movimiento[]> = {};

    if (tarjeta?.tipo === 'Crédito' && tarjeta.diaCorte != null && Number(tarjeta.diaCorte) > 0) {
      // Agrupar por periodo de corte
      const cutDay = Number(tarjeta.diaCorte);
      for (const mov of filtered) {
        if (!mov.fecha) continue;
        const d = new Date(mov.fecha + 'T00:00:00');
        if (isNaN(d.getTime())) continue;

        const day = d.getDate();
        const month = d.getMonth();
        const year = d.getFullYear();
        
        let startPeriod: Date;
        let endPeriod: Date;

        if (day >= cutDay) {
          startPeriod = new Date(year, month, cutDay);
          endPeriod = new Date(year, month + 1, cutDay - 1);
        } else {
          startPeriod = new Date(year, month - 1, cutDay);
          endPeriod = new Date(year, month, cutDay - 1);
        }

        const startStr = startPeriod.toLocaleString('es-MX', { day: 'numeric', month: 'short' });
        const endStr = endPeriod.toLocaleString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' });
        const capKey = `${startStr} - ${endStr}`.replace(/\b\w/g, l => l.toUpperCase());
        
        if (!groups[capKey]) groups[capKey] = [];
        groups[capKey].push(mov);
      }
    } else {
      // Agrupar por mes natural (Débito o sin diaCorte)
      for (const mov of filtered) {
        if (!mov.fecha) continue;
        const date = new Date(mov.fecha + 'T00:00:00');
        if (isNaN(date.getTime())) continue;

        const key = date.toLocaleString('es-MX', { month: 'long', year: 'numeric' });
        const capKey = key.charAt(0).toUpperCase() + key.slice(1);
        if (!groups[capKey]) groups[capKey] = [];
        groups[capKey].push(mov);
      }
    }
    
    return groups;
  }, [movimientos, searchTerm, tarjeta]);

  if (!mounted) return null;

  return createPortal(
    <AnimatePresence>
      {tarjeta && (
        <motion.div
          initial={{ opacity: 0 }}
