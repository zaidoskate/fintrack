    onSuccess: () => {
      qc.invalidateQueries({ queryKey: QK.movimientos() });
      qc.invalidateQueries({ queryKey: QK.tarjetas });
    },
    onError: (err, variables) => handleOfflineError('traspasoEfectivo', variables, err)
  });
