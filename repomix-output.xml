'use client';

/**
 * QueryProvider — envuelve la app con QueryClientProvider de TanStack Query.
 * Architecture.md §4: state management de server state SOLO vía TanStack Query.
 * staleTime por tipo de dato (Architecture.md §4):
 *   - movimientos: 60s
 *   - tarjetas/metas: 5 min
 */
import { QueryClient } from '@tanstack/react-query';
import { PersistQueryClientProvider } from '@tanstack/react-query-persist-client';
import { useState, useEffect } from 'react';
import { get, set, del } from 'idb-keyval';
import type { Persister } from '@tanstack/react-query-persist-client';

function createIDBPersister(idbValidKey: IDBValidKey = 'reactQuery'): Persister {
  return {
    persistClient: async (client: unknown) => {
      await set(idbValidKey, client);
    },
    restoreClient: async () => {
      return await get(idbValidKey);
    },
    removeClient: async () => {
      await del(idbValidKey);
    },
  };
}

const idbPersister = createIDBPersister('fintrack-query-cache');

export function QueryProvider({ children }: { children: React.ReactNode }) {
  const [queryClient] = useState(
    () =>
      new QueryClient({
        defaultOptions: {
          queries: {
            staleTime:            60_000,   // 60s default
            gcTime:               24 * 60 * 60 * 1000, // 24 hours
            retry:                1,
            refetchOnWindowFocus: true,
          },
        },
      }),
  );

  useEffect(() => {
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.addEventListener('message', (event) => {
        if (event.data?.type === 'SYNC_NOW') {
          // You could trigger a sync processing here if it was pending
        }
      });

      // Handle Service Worker updates
      navigator.serviceWorker.getRegistration().then((reg) => {
        if (!reg) return;
        reg.addEventListener('updatefound', () => {
          const newWorker = reg.installing;
          if (newWorker) {
            newWorker.addEventListener('statechange', () => {
              if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                // Notifica al usuario de nueva version
                window.dispatchEvent(new CustomEvent('sw-update-available', {
                  detail: { worker: newWorker }
                }));
              }
            });
          }
        });
      });
    }
  }, []);

  return (
    <PersistQueryClientProvider
      client={queryClient}
      persistOptions={{ persister: idbPersister }}
    >
      {children}
    </PersistQueryClientProvider>
  );
}
</file>

<file path="src/lib/ui/feedback.ts">
'use client';

/**
 * Dispara una vibración háptica suave si el dispositivo lo soporta.
 */
export function triggerHaptic(type: 'light' | 'success' | 'warning') {
  if (typeof navigator === 'undefined' || !navigator.vibrate) return;
  
  switch (type) {
    case 'light':
      navigator.vibrate(8);
      break;
    case 'success':
      navigator.vibrate([12, 30, 15]);
      break;
    case 'warning':
      navigator.vibrate([20, 20, 20]);
      break;
  }
}

export function playSuccessChime() {
  if (typeof window === 'undefined') return;
  
  try {
    const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
    if (!AudioContextClass) return;
    
    const ctx = new AudioContextClass();
    
    // Un arpegio brillante: C6 (1046.5Hz), E6 (1318.5Hz), G6 (1567.9Hz)
    const notes = [1046.5, 1318.5, 1567.9];
    const duration = 0.8;
    
    notes.forEach((freq, i) => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, ctx.currentTime);
      
      const startTime = ctx.currentTime + (i * 0.1); // Arpegio separado por 100ms
      
      gain.gain.setValueAtTime(0, startTime);
      gain.gain.linearRampToValueAtTime(0.15, startTime + 0.05); // Attack más marcado
      gain.gain.exponentialRampToValueAtTime(0.001, startTime + duration); // Decay largo
      
      osc.connect(gain);
      gain.connect(ctx.destination);
      
      osc.start(startTime);
      osc.stop(startTime + duration + 0.1);
    });
  } catch (err) {
    console.warn('AudioContext no soportado o bloqueado', err);
  }
}
