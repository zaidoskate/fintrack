                  display: 'flex', alignItems: 'center', gap: '16px', transition: 'all 0.2s'
                }}
              >
                <div style={{ background: 'var(--surface-glass)', padding: '12px', borderRadius: '12px', color: 'var(--credito-verde)' }}>
