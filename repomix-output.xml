                      style={{ flex: 1, padding: '10px', borderRadius: '10px', background: bankType === 'Débito' ? 'rgba(255,255,255,0.1)' : 'transparent', color: bankType === 'Débito' ? 'var(--text-primary)' : 'var(--text-muted)', border: 'none', cursor: 'pointer', fontWeight: 500, transition: 'all 0.2s' }}
                    >
                      Débito
                    </button>
                    <button
                      type="button"
                      onClick={() => setBankType('Crédito')}
                      style={{ flex: 1, padding: '10px', borderRadius: '10px', background: bankType === 'Crédito' ? 'rgba(255,255,255,0.1)' : 'transparent', color: bankType === 'Crédito' ? 'var(--text-primary)' : 'var(--text-muted)', border: 'none', cursor: 'pointer', fontWeight: 500, transition: 'all 0.2s' }}
                    >
                      Crédito
                    </button>
                  </div>
                )}

                <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
                  <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
                    <label style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>
                      Nombre de la {accountType === 'yield' ? 'inversión' : 'cuenta'}
                    </label>
                    <input 
                      type="text" 
                      required 
                      placeholder={accountType === 'yield' ? 'Ej: CETES Directo, Finsus' : 'Ej: BBVA, Santander'}
                      value={formData.name}
                      onChange={e => setFormData({ ...formData, name: e.target.value })}
                      style={{ width: '100%', padding: '16px', borderRadius: '16px', background: 'var(--surface-glass)', border: '1px solid var(--border-glass)', color: 'var(--text-primary)', fontSize: '16px', outline: 'none' }}
                    />
                  </div>

                  {accountType === 'bank' && bankType === 'Crédito' && (
                    <div style={{ display: 'flex', gap: '12px' }}>
                      <div style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: '8px' }}>
                        <label style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>Día de Corte</label>
                        <input 
                          type="number" min="1" max="31" required 
                          placeholder="Ej: 15"
                          value={creditData.diaCorte}
                          onChange={e => setCreditData({ ...creditData, diaCorte: e.target.value })}
                          style={{ width: '100%', padding: '16px', borderRadius: '16px', background: 'var(--surface-glass)', border: '1px solid var(--border-glass)', color: 'var(--text-primary)', fontSize: '16px', outline: 'none' }}
                        />
                      </div>
                      <div style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: '8px' }}>
                        <label style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>Día de Pago</label>
                        <input 
                          type="number" min="1" max="31" required 
                          placeholder="Ej: 5"
                          value={creditData.diaPago}
                          onChange={e => setCreditData({ ...creditData, diaPago: e.target.value })}
                          style={{ width: '100%', padding: '16px', borderRadius: '16px', background: 'var(--surface-glass)', border: '1px solid var(--border-glass)', color: 'var(--text-primary)', fontSize: '16px', outline: 'none' }}
                        />
                      </div>
                    </div>
                  )}

                  <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
                    <label style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>
                      {accountType === 'bank' && bankType === 'Crédito' ? 'Límite de crédito' : 'Saldo inicial'}
                    </label>
                    <div style={{ position: 'relative' }}>
                      <span style={{ position: 'absolute', left: '16px', top: '50%', transform: 'translateY(-50%)', color: 'var(--text-muted)' }}>$</span>
                      <input 
                        type="number" 
                        required={!(accountType === 'bank' && bankType === 'Crédito')}
                        step="0.01"
                        placeholder={accountType === 'bank' && bankType === 'Crédito' ? "Ej: 20000" : "0.00"}
                        value={accountType === 'bank' && bankType === 'Crédito' ? creditData.limite : formData.balance}
                        onChange={e => {
                          if (accountType === 'bank' && bankType === 'Crédito') {
                            setCreditData({ ...creditData, limite: e.target.value });
                          } else {
                            setFormData({ ...formData, balance: e.target.value });
                          }
                        }}
                        style={{ width: '100%', padding: '16px 16px 16px 32px', borderRadius: '16px', background: 'var(--surface-glass)', border: '1px solid var(--border-glass)', color: 'var(--text-primary)', fontSize: '16px', outline: 'none' }}
                      />
                    </div>
                  </div>

                  {accountType === 'bank' && bankType === 'Crédito' && (
                    <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
                      <label style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>
                        Deuda actual (Opcional)
                      </label>
                      <div style={{ position: 'relative' }}>
                        <span style={{ position: 'absolute', left: '16px', top: '50%', transform: 'translateY(-50%)', color: 'var(--text-muted)' }}>$</span>
                        <input 
                          type="number" 
                          step="0.01"
                          placeholder="0.00"
                          value={formData.balance}
                          onChange={e => setFormData({ ...formData, balance: e.target.value })}
                          style={{ width: '100%', padding: '16px 16px 16px 32px', borderRadius: '16px', background: 'var(--surface-glass)', border: '1px solid var(--border-glass)', color: 'var(--text-primary)', fontSize: '16px', outline: 'none' }}
                        />
                      </div>
                    </div>
                  )}

                  {accountType === 'bank' && bankType === 'Débito' && (
                    <div style={{ marginTop: '16px', background: 'rgba(255,255,255,0.02)', padding: '16px', borderRadius: '16px', border: '1px solid var(--border-glass)' }}>
                      <label style={{ display: 'flex', alignItems: 'center', gap: '12px', cursor: 'pointer' }}>
                        <input 
                          type="checkbox" 
                          checked={addApartado} 
                          onChange={e => setAddApartado(e.target.checked)}
                          style={{ width: '18px', height: '18px', accentColor: 'var(--brand)' }}
                        />
                        <div>
                          <div style={{ fontSize: '14px', color: 'var(--text-primary)' }}>Crear apartado con rendimientos</div>
                          <div style={{ fontSize: '12px', color: 'var(--text-muted)' }}>(Ej: Cajitas, apartados)</div>
                        </div>
                      </label>
                      
                      {addApartado && (
                        <div style={{ marginTop: '16px', display: 'flex', flexDirection: 'column', gap: '12px' }}>
                          <input 
                            type="text" 
                            placeholder="Nombre del apartado (Ej: Cajita)"
                            value={apartadoName}
                            onChange={e => setApartadoName(e.target.value)}
                            required={addApartado}
                            style={{ width: '100%', padding: '14px', borderRadius: '12px', background: 'var(--surface-glass)', border: '1px solid var(--border-glass)', color: 'var(--text-primary)', outline: 'none' }}
                          />
                          <input 
                            type="number" 
                            step="0.01"
                            placeholder="Rendimiento Anual (APY %)"
                            value={apartadoApy}
                            onChange={e => setApartadoApy(e.target.value)}
                            required={addApartado}
                            style={{ width: '100%', padding: '14px', borderRadius: '12px', background: 'var(--surface-glass)', border: '1px solid var(--border-glass)', color: 'var(--text-primary)', outline: 'none' }}
                          />
                        </div>
                      )}
                    </div>
                  )}

                  {accountType === 'yield' && (
                    <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
                      <label style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>Rendimiento Anual (APY)</label>
                      <div style={{ position: 'relative' }}>
                        <input 
                          type="number" step="0.01" required placeholder="13.5"
                          className="glass-input" style={{ paddingRight: '32px' }}
                          value={formData.apy} onChange={(e) => setFormData({...formData, apy: e.target.value})}
                        />
                        <span style={{ position: 'absolute', right: '16px', top: '14px', color: 'var(--text-muted)' }}>%</span>
                      </div>
                    </div>
                  )}
                </div>

                {errorMsg && (
                  <div style={{ color: 'var(--credito-rojo)', fontSize: '13px', background: 'rgba(239,68,68,0.1)', padding: '10px', borderRadius: '8px' }}>
                    {errorMsg}
                  </div>
                )}

                <button 
                  type="submit" disabled={isSubmitting || !formData.name || !formData.balance}
                  style={{
                    width: '100%', marginTop: '8px', padding: '16px', borderRadius: '12px',
                    background: 'var(--brand)', color: '#fff',
                    fontSize: '15px', fontWeight: 600, border: 'none', cursor: 'pointer',
                    display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '8px',
                    opacity: (isSubmitting || !formData.name || !formData.balance) ? 0.7 : 1,
                    transition: 'opacity 0.2s'
                  }}
                >
                  {isSubmitting ? <Loader2 size={18} className="spin" /> : 'Finalizar configuración'}
                </button>
              </form>
            </GlassCard>
            
            <button 
              onClick={() => setStep(1)} disabled={isSubmitting}
              style={{ background: 'none', border: 'none', color: 'var(--text-muted)', fontSize: '14px', width: '100%', textAlign: 'center', marginTop: '20px', cursor: 'pointer' }}
            >
              Volver atrás
            </button>
          </motion.div>
        )}

        {step === 3 && (
          <motion.div key="step3" variants={fadeVariants} initial="hidden" animate="visible" exit="exit" style={{ textAlign: 'center', padding: '40px 0' }}>
            <motion.div 
              animate={{ rotate: 360 }} transition={{ repeat: Infinity, duration: 2, ease: "linear" }}
              style={{ display: 'inline-block', marginBottom: '24px' }}
            >
              <Loader2 size={48} color="var(--brand)" />
            </motion.div>
            <h1 style={{ fontFamily: 'var(--font-display)', fontSize: '24px', color: 'var(--text-primary)', marginBottom: '8px' }}>
              Dejando todo listo para ti...
            </h1>
            <p style={{ color: 'var(--text-secondary)', fontSize: '15px' }}>
              Creando tu cuenta inicial y preparando tu panel mágico.
            </p>
          </motion.div>
        )}

      </AnimatePresence>
      <style>{`
        .spin {
          animation: spin 1s linear infinite;
        }
        @keyframes spin {
          100% { transform: rotate(360deg); }
        }
      `}</style>
    </div>
  );
}
</file>

<file path="src/app/globals.css">
@import "tailwindcss";

/* ══════════════════════════════════════════════════════════════════════════════
   FinTrack — Design System "Glass Ledger" v1.0
   Fuente de verdad: docs/design/glass-ledger-mockup.html
   Regla H4 (UX_UI_Heuristics.md): las paletas credito-* y categoria-* son
   COMPLETAMENTE SEPARADAS. El rojo de alerta (#EF4444) nunca debe confundirse
   con el coral de marca (#FA686F) — son tokens distintos sin uso cruzado.
══════════════════════════════════════════════════════════════════════════════ */

/* ── Variables CSS base (compartidas entre @theme y CSS propio) ─────────────── */
:root {
  /* Marca — extraídos literalmente de la maqueta */
  --brand:        #FA686F;
  --brand-dim:    rgba(250, 104, 111, 0.35);
  --brand-deep:   #7A2530;

  /* Superficies Glass Ledger */
  --bg-base:      #0F0A0B;
  --surface-glass: rgba(255, 255, 255, 0.06);
  --border-glass:  rgba(255, 255, 255, 0.12);

  /* Texto — de la maqueta */
  --text-primary:   #F5F5F7;
  --text-secondary: rgba(245, 245, 247, 0.6);
  --text-muted:     rgba(245, 245, 247, 0.4);

  /* ── PALETA SEMÁNTICA TERMÓMETRO (H4: exclusiva, nunca mezclar con marca) ─ */
  --credito-verde:    #34D399;
  --credito-amarillo: #FBBF24;
  --credito-rojo:     #EF4444;   /* ← DISTINTO de --brand #FA686F */

  /* Fondos semitransparentes para pills/badges del termómetro */
  --credito-verde-bg:    rgba(52, 211, 153, 0.15);
  --credito-amarillo-bg: rgba(251, 191, 36, 0.15);
  --credito-rojo-bg:     rgba(239, 68, 68, 0.15);

  /* Glows para card::before (extraídos de .card-amber::before y .card-rojo::before) */
  --credito-verde-glow:    #34D399;
  --credito-amarillo-glow: #FBBF24;
  --credito-rojo-glow:     #EF4444;

  /* Sincronización (H1: visibilidad del estado) */
  --sync-pending:   #FBBF24;   /* ámbar — reutiliza amarillo del termómetro */
  --sync-error:     #EF4444;   /* rojo — mismo token que credito-rojo */
  --sync-ok:        #34D399;   /* verde */

  /* Borde focus ring */
  --border-focus:  rgba(250, 104, 111, 0.6);
}

/* ── @theme — Tailwind v4: exposición como utilidades ──────────────────────── */
@theme {

  /* ── 1. COLORES DE MARCA ───────────────────────────────────────────────── */
  --color-brand:        #FA686F;
  --color-brand-dim:    rgba(250, 104, 111, 0.35);
  --color-brand-deep:   #7A2530;

  /* ── 2. SUPERFICIES ───────────────────────────────────────────────────── */
  --color-bg-base:      #0F0A0B;
  --color-surface-glass: rgba(255, 255, 255, 0.06);
  --color-border-glass:  rgba(255, 255, 255, 0.12);

  /* ── 3. TEXTO ──────────────────────────────────────────────────────────── */
  --color-text-primary:   #F5F5F7;
  --color-text-secondary: rgba(245, 245, 247, 0.6);
  --color-text-muted:     rgba(245, 245, 247, 0.4);

  /* ── 4. PALETA TERMÓMETRO DE CRÉDITO (H4 — EXCLUSIVA) ─────────────────── */
  /* Verde — "Rango ideal" (≤ 30%) */
  --color-credito-verde:    #34D399;
  --color-credito-verde-bg: rgba(52, 211, 153, 0.15);

  /* Amarillo — "Aún puedes gastar" (31–70%) */
  --color-credito-amarillo:    #FBBF24;
  --color-credito-amarillo-bg: rgba(251, 191, 36, 0.15);

  /* Rojo — "Te excediste" / "Límite casi alcanzado" (≥ 71%) */
  /* CRÍTICO: #EF4444 ≠ brand #FA686F — distintos hue, propósito y contexto */
  --color-credito-rojo:    #EF4444;
  --color-credito-rojo-bg: rgba(239, 68, 68, 0.15);

  /* ── 5. PALETA CATEGORÍAS DE GASTO (H4 — nunca usar colores semáforo aquí) */
  --color-categoria-comida:          #818cf8;  /* indigo-400 */
  --color-categoria-transporte:      #38bdf8;  /* sky-400 */
  --color-categoria-entretenimiento: #c084fc;  /* purple-400 */
  --color-categoria-salud:           #2dd4bf;  /* teal-400 */
  --color-categoria-ropa:            #f472b6;  /* pink-400 */
  --color-categoria-conveniencia:    #a78bfa;  /* violet-400 */
  --color-categoria-servicios:       #67e8f9;  /* cyan-300 */
  --color-categoria-otro:            #94a3b8;  /* slate-400 — fallback */
  --color-ingreso:                   #34d399;  /* emerald-400 — solo en contexto de ingreso */

  /* ── 6. TIPOGRAFÍA ─────────────────────────────────────────────────────── */
  /* Fuentes cargadas vía next/font/google en layout.tsx */
  --font-display: var(--font-space-grotesk), 'Space Grotesk', ui-sans-serif, system-ui;
  --font-sans:    var(--font-inter), 'Inter', ui-sans-serif, system-ui;
  --font-mono:    var(--font-jetbrains-mono), 'JetBrains Mono', ui-monospace, monospace;

  /* Escala — extraída de la maqueta (valores literales) */
  --font-size-2xs: 0.6875rem;  /* 11px — disponible-label uppercase */
  --font-size-xs:  0.75rem;    /* 12px — pills */
  --font-size-sm:  0.875rem;   /* 14px — subtítulo, texto secundario */
  --font-size-base: 1rem;      /* 16px — UI general */
  --font-size-md:  1rem;       /* 16px — card-name */
  --font-size-lg:  1.25rem;    /* 20px — brand-name */
  --font-size-xl:  1.375rem;   /* 22px — disponible-monto */
  --font-size-2xl: 1.625rem;   /* 26px — h1 de sección */
  --font-size-3xl: 2rem;       /* 32px — montos hero */

  /* Pesos */
  --font-weight-normal:   400;
  --font-weight-medium:   500;
  --font-weight-semibold: 600;
  --font-weight-bold:     700;

  /* Letter-spacing de la maqueta */
  --tracking-display:  -0.02em;   /* Space Grotesk headlines */
  --tracking-mono:      0.08em;   /* JetBrains Mono card-number */
  --tracking-label:     0.06em;   /* disponible-label uppercase */
  --tracking-badge:     0em;

  /* ── 7. ESPACIADO (escala 4pt) ─────────────────────────────────────────── */
  --spacing-1:  0.25rem;    /* 4px */
  --spacing-2:  0.5rem;     /* 8px */
  --spacing-3:  0.75rem;    /* 12px */
  --spacing-4:  1rem;       /* 16px */
  --spacing-5:  1.25rem;    /* 20px */
  --spacing-6:  1.5rem;     /* 24px */  /* card padding */
  --spacing-7:  1.75rem;    /* 28px */
  --spacing-8:  2rem;       /* 32px */  /* header margin-bottom */
  --spacing-10: 2.5rem;     /* 40px */
  --spacing-12: 3rem;       /* 48px */
  --spacing-16: 4rem;       /* 64px */
  --spacing-20: 5rem;       /* 80px */  /* body padding-bottom (FAB) */

  /* ── 8. BORDER RADIUS — de la maqueta ────────────────────────────────── */
  --radius-chip:  0.3125rem;  /* 5px — chip de tarjeta */
  --radius-logo:  0.75rem;    /* 12px — logo */
  --radius-card:  1.375rem;   /* 22px — .card border-radius */
  --radius-pill:  9999px;     /* 100px — .pill border-radius */

  /* ── 9. SOMBRAS — de la maqueta ───────────────────────────────────────── */
  --shadow-card: 0 8px 32px rgba(0, 0, 0, 0.45);
  --shadow-fab:  0 8px 24px rgba(250, 104, 111, 0.35);   /* = brand-dim */

  /* ── 10. BACKDROP FILTER (Glass Ledger signature) ─────────────────────── */
  --backdrop-glass: blur(24px) saturate(160%);

  /* ── 11. BLOBS (AmbientBackground) ────────────────────────────────────── */
  /* Coral blob: top -120px / left -100px / 420×420px / blur 90px / opacity 0.35 */
  /* Deep blob:  bottom -160px / right -140px / 460×460px / blur 90px / opacity 0.40 */

  /* ── 12. ANIMACIONES ──────────────────────────────────────────────────── */
  --duration-fast:   150ms;
  --duration-base:   250ms;
  --duration-slow:   400ms;
  --ease-out:   cubic-bezier(0.0, 0.0, 0.2, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  /* ── 13. Z-INDEX ──────────────────────────────────────────────────────── */
  --z-blob:     0;
  --z-content:  1;
  --z-sticky:   10;
  --z-dropdown: 100;
  --z-modal:    200;
  --z-toast:    300;
  --z-fab:      2;   /* igual que la maqueta */

  /* ── 14. BREAKPOINTS ──────────────────────────────────────────────────── */
  --breakpoint-sm:  480px;
  --breakpoint-md:  768px;
  --breakpoint-lg:  1024px;
}

/* ══════════════════════════════════════════════════════════════════════════════
   Estilos base globales
══════════════════════════════════════════════════════════════════════════════ */

*, *::before, *::after {
  box-sizing: border-box;
}

html {
  color-scheme: dark;
  -webkit-text-size-adjust: 100%;
  font-feature-settings: "kern" 1, "liga" 1, "calt" 1;
  height: 100%;
}

body {
  background-color: var(--bg-base);
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
  line-height: 1.5;
  min-height: 100%;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Montos y cifras financieras — siempre JetBrains Mono con cifras tabulares */
.font-mono,
.font-amount {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

/* Títulos y display — Space Grotesk */
.font-display {
  font-family: var(--font-display);
  letter-spacing: var(--tracking-display);
}

/* Focus ring consistente usando brand como color */
:focus-visible {
  outline: 2px solid var(--border-focus);
  outline-offset: 2px;
  border-radius: 4px;
}

/* Transiciones base para interactivos */
a, button, [role="button"] {
  transition:
    opacity    var(--duration-fast) var(--ease-out),
    background var(--duration-fast) var(--ease-out),
    color      var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
}

/* Scrollbar discreta */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.12);
  border-radius: 2px;
}

/* ── Clase utilitaria para inputs de auth (Server Components — sin onFocus/onBlur) ── */
.glass-input {
  width: 100%;
  border-radius: 10px;
  padding: 11px 14px;
  border: 1px solid var(--border-glass);
  background: rgba(255, 255, 255, 0.06);
  color: var(--text-primary);
  font-size: 1rem;
  outline: none;
  transition: border-color 150ms ease, box-shadow 150ms ease;
  font-family: inherit;
}

.glass-input::placeholder {
  color: var(--text-muted);
}

.glass-input:focus {
  border-color: var(--border-focus);
  box-shadow: 0 0 0 3px rgba(250, 104, 111, 0.12);
}

.glass-input:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

@keyframes jiggle {
  0% { transform: rotate(-1deg) scale(0.98); }
  50% { transform: rotate(1.5deg) scale(0.98); }
  100% { transform: rotate(-1deg) scale(0.98); }
}

.animate-jiggle {
  animation: jiggle 0.3s infinite;
  transform-origin: center center;
}
