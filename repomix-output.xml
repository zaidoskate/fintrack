<file path="src/components/dashboard/analytics/PatrimonialAnalytics.tsx">
import { useMemo, useState, useEffect } from 'react';
import { AreaChart, Area, XAxis, YAxis, ResponsiveContainer, Tooltip } from 'recharts';
import type { PortafolioActivo, CuentaYield, TarjetaConEstado } from '@/lib/types';
import { Loader } from '@/components/ui/Loader';
import { GlassSelect } from '@/components/ui/GlassSelect';

interface HistData {
  timestamps: number[];
  prices: number[];
  currency: string;
}

// Tooltip invisible para extraer el estado activo hacia el padre sin errores de React
// eslint-disable-next-line @typescript-eslint/no-explicit-any
function StateLifterTooltip({ active, payload, setActivePoint }: any) {
  useEffect(() => {
    if (active && payload && payload.length > 0) {
      const newVal = payload[0].payload.total;
      const newTs = payload[0].payload.timestamp;
      
      setActivePoint((prev: { value: number; timestamp: number } | null) => {
        if (prev && prev.value === newVal && prev.timestamp === newTs) {
          return prev; // Evita re-render infinito
        }
        return { value: newVal, timestamp: newTs };
      });
    } else {
      setActivePoint((prev: { value: number; timestamp: number } | null) => {
        if (prev === null) return prev;
        return null;
      });
    }
  }, [active, payload, setActivePoint]);
  return null;
}

export function PatrimonialAnalytics({ activos, yields, tarjetas = [], balanceEfectivo = 0, displayCurrency, rates }: { activos: PortafolioActivo[]; yields: CuentaYield[]; tarjetas?: TarjetaConEstado[]; balanceEfectivo?: number; displayCurrency: string; rates: Record<string, number> }) {
  const getConvertedValue = (valMXN: number) => {
    if (displayCurrency === 'USD' && rates['MXN=X']) return valMXN / rates['MXN=X'];
    if (displayCurrency === 'EUR' && rates['EURMXN=X']) return valMXN / rates['EURMXN=X'];
    if (displayCurrency === 'BTC' && rates['BTC-USD']) return valMXN / rates['BTC-USD'];
    return valMXN;
  };

  const formatConverted = (valMXN: number, minDecimals = 0) => {
    const val = getConvertedValue(valMXN);
    if (displayCurrency === 'BTC') return `₿ ${val.toFixed(6)}`;
    try {
      return new Intl.NumberFormat('es-MX', { style: 'currency', currency: displayCurrency, minimumFractionDigits: minDecimals, maximumFractionDigits: 2 }).format(val);
    } catch {
      return `${displayCurrency} ${val.toFixed(2)}`;
    }
  };
  // 1. Datos para la Donut de Distribución
  const distData = useMemo(() => {
    let crypto = 0, stock = 0, etf = 0, yieldTot = 0;
    activos.forEach(a => {
      if (a.tipo === 'crypto') crypto += (a.valorTotal || 0);
      else if (a.tipo === 'stock') stock += (a.valorTotal || 0);
      else if (a.tipo === 'etf') etf += (a.valorTotal || 0);
    });
    yields.forEach(y => {
      yieldTot += (y.valorTotalMXN || y.balanceActual);
    });
    
    return [
      { name: 'Criptomonedas', value: crypto, color: '#f59e0b' },
      { name: 'Acciones', value: stock, color: '#3b82f6' },
      { name: 'ETFs', value: etf, color: '#8b5cf6' },
      { name: 'Cuentas Yield', value: yieldTot, color: '#10b981' }
    ].filter(d => d.value > 0);
  }, [activos, yields]);

  // 2. Proyección de Ingresos Pasivos
  const pasivoMensual = useMemo(() => {
    let totalMensualMXN = 0;
    
    // De Cuentas Yield Dedicadas
    yields.forEach(y => {
      const valor = y.valorTotalMXN || y.balanceActual; 
      const anual = valor * (y.apy / 100);
      totalMensualMXN += (anual / 12);
    });

    // De Tarjetas de Débito y Apartados
    tarjetas.forEach(t => {
      if (t.tipo === 'Débito' && (t.rendimientoAnual || 0) > 0) {
        totalMensualMXN += (t.disponible * (t.rendimientoAnual / 100)) / 12;
      }
      if (t.apartados) {
        t.apartados.forEach(a => {
          if ((a.rendimientoAnual || 0) > 0) {
            totalMensualMXN += (a.balanceCalculado * (a.rendimientoAnual / 100)) / 12;
          }
        });
      }
    });

    return totalMensualMXN;
  }, [yields, tarjetas]);

  // 3. Timeline Histórico
  const [range, setRange] = useState<'12h' | '1d' | '1w' | '1m' | '6m'>('1w');
  const [assetFilter, setAssetFilter] = useState<string>('all');
  const [rawData, setRawData] = useState<Record<string, HistData>>({});
  const [loadingHist, setLoadingHist] = useState(false);
  const [activePoint, setActivePoint] = useState<{ value: number; timestamp: number } | null>(null);

  const activosKey = useMemo(() => activos.map(a => `${a.simbolo}:${a.cantidad}`).join(','), [activos]);

  useEffect(() => {
    if (activos.length === 0) return;

    let r = '5d';
    let i = '1h';
    if (range === '12h') { r = '1d'; i = '15m'; }
    else if (range === '1d') { r = '1d'; i = '5m'; }
    else if (range === '1w') { r = '5d'; i = '15m'; }
    else if (range === '1m') { r = '1mo'; i = '1d'; }
    else if (range === '6m') { r = '6mo'; i = '1d'; }

    const mapSymbol = (s: string, tipo: string) => {
      if (tipo === 'crypto') return `${s}-USD`;
      return s;
    };
    
    const symbolsQuery = activos.map(a => mapSymbol(a.simbolo, a.tipo)).join(',');
    
    // eslint-disable-next-line react-hooks/set-state-in-effect
    setLoadingHist(true);
    fetch(`/api/historical?symbols=${symbolsQuery}&range=${r}&interval=${i}`)
      .then(res => res.json())
      .then(data => setRawData(data))
      .catch(console.error)
      .finally(() => setLoadingHist(false));

  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [range, activosKey]);

  const histData = useMemo(() => {
    if (!rawData || Object.keys(rawData).length === 0) return [];
    
    const allTimestamps = new Set<number>();
    Object.values(rawData).forEach(d => {
      if (d.timestamps) d.timestamps.forEach(t => allTimestamps.add(t));
    });
    
    const sortedTimestamps = Array.from(allTimestamps).sort((a, b) => a - b);
    
    const getPriceAt = (arrTs: number[], arrPx: number[], targetTs: number) => {
      if (!arrTs || arrTs.length === 0) return 0;
      let lastPx = arrPx[0];
      for (let k = 0; k < arrTs.length; k++) {
        if (arrTs[k] <= targetTs) lastPx = arrPx[k];
        else break;
      }
      return lastPx;
    };

    let flatBaselineMXN = 0;
    if (assetFilter === 'all') {
      flatBaselineMXN += balanceEfectivo;
      yields.forEach(y => { flatBaselineMXN += (y.valorTotalMXN || y.balanceActual); });
      tarjetas.forEach(t => { 
        if (t.tipo === 'Débito') {
          flatBaselineMXN += t.disponible;
          if (t.apartados) {
            t.apartados.forEach(a => { flatBaselineMXN += a.balanceCalculado; });
          }
        }
      });
    }

    return sortedTimestamps.map(ts => {
      let totalMXN = flatBaselineMXN;
      const mxnRate = getPriceAt(rawData['MXN=X']?.timestamps || [], rawData['MXN=X']?.prices || [], ts) || 19.5;

      activos.forEach(a => {
        if (assetFilter !== 'all' && a.simbolo !== assetFilter) return;

        const sym = a.tipo === 'crypto' ? `${a.simbolo}-USD` : a.simbolo;
        const hd = rawData[sym];
        if (hd) {
          let px = getPriceAt(hd.timestamps, hd.prices, ts);
          if (hd.currency === 'USD') px = px * mxnRate;
          totalMXN += (px * a.cantidad);
        }
      });

      let totalConverted = totalMXN;
      if (displayCurrency === 'USD' && rates['MXN=X']) totalConverted = totalMXN / rates['MXN=X'];
      if (displayCurrency === 'EUR' && rates['EURMXN=X']) totalConverted = totalMXN / rates['EURMXN=X'];
      if (displayCurrency === 'BTC' && rates['BTC-USD']) totalConverted = totalMXN / rates['BTC-USD'];

      const d = new Date(ts * 1000);
      let timeLabel = '';
      if (range === '1m' || range === '6m') {
        timeLabel = d.toLocaleDateString('es-MX', { month: 'short', day: 'numeric' });
      } else if (range === '1w') {
        timeLabel = d.toLocaleDateString('es-MX', { weekday: 'short' });
        timeLabel = timeLabel.charAt(0).toUpperCase() + timeLabel.slice(1);
      } else {
        timeLabel = d.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', hour12: true });
      }

      return { timestamp: ts, timeLabel, total: totalConverted };
    });
  }, [rawData, assetFilter, activos, range, displayCurrency, rates, yields, tarjetas, balanceEfectivo]);

  const totalDist = distData.reduce((sum, d) => sum + d.value, 0);

  const initialValue = histData.length > 0 ? histData[0].total : 0;
  const lastValue = histData.length > 0 ? histData[histData.length - 1].total : 0;
  
  const displayValue = activePoint ? activePoint.value : lastValue;
  const diff = displayValue - initialValue;
  const diffPct = initialValue > 0 ? (diff / initialValue) * 100 : 0;
  const isPositive = lastValue >= initialValue;
  
  const strokeColor = isPositive ? 'var(--credito-verde)' : 'var(--brand)';

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: '8px', marginBottom: '12px' }}>
      
      {/* Píldora de Ingresos Pasivos */}
      { pasivoMensual > 0 && (
        <div style={{ display: 'flex' }}>
          <div style={{ 
            background: 'rgba(16, 185, 129, 0.15)', 
            border: '1px solid rgba(16, 185, 129, 0.3)', 
            color: 'var(--credito-verde)', 
            padding: '6px 12px', 
            borderRadius: '100px', 
            fontSize: '13px', 
            fontWeight: 600, 
            display: 'flex', 
            alignItems: 'center', 
            gap: '6px' 
          }}>
            +{formatConverted(pasivoMensual)} / mes pasivo
          </div>
        </div>
      )}

      {/* Timeline Histórico Compacto */}
      <div style={{ position: 'relative' }}>
        <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '8px', marginBottom: '4px', zIndex: 20 }}>
          <div style={{ width: '130px' }}>
            <GlassSelect 
              size="sm"
              options={[
                { value: 'all', label: 'Portafolio' },
                ...activos.map(a => ({ value: a.simbolo, label: a.simbolo }))
              ]}
              value={assetFilter} 
              onChange={setAssetFilter}
            />
          </div>

          <div style={{ display: 'flex', background: 'rgba(255,255,255,0.05)', borderRadius: '8px', padding: '2px' }}>
            {['12h', '1d', '1w', '1m', '6m'].map(r => (
              <button
                key={r}
                onClick={() => setRange(r as '12h' | '1d' | '1w' | '1m' | '6m')}
                style={{
                  background: range === r ? 'rgba(255,255,255,0.15)' : 'transparent',
                  color: range === r ? '#fff' : 'var(--text-muted)',
                  border: 'none', padding: '4px 10px', borderRadius: '6px',
                  fontSize: '11px', fontWeight: 600, cursor: 'pointer', transition: 'all 0.2s'
                }}
              >
                {r.toUpperCase()}
              </button>
            ))}
          </div>
        </div>

        <div style={{ padding: '0 0 12px 4px' }}>
          <div style={{ fontFamily: 'var(--font-mono)', fontSize: '32px', fontWeight: 700, color: 'var(--text-primary)', lineHeight: 1 }}>
            {formatConverted(displayValue, 2)}
          </div>
          <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginTop: '6px' }}>
            <div style={{ fontSize: '14px', fontWeight: 500, color: diff >= 0 ? 'var(--credito-verde)' : 'var(--credito-rojo)' }}>
              {diff >= 0 ? '+' : ''}{formatConverted(diff, 2)} ({diff >= 0 ? '+' : ''}{diffPct.toFixed(2)}%)
            </div>
            {activePoint && (
              <div style={{ fontSize: '12px', color: 'var(--text-muted)' }}>
                • {(() => {
                  const d = new Date(activePoint.timestamp * 1000);
                  if (range === '12h' || range === '1d') return d.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
                  if (range === '1w') return `${d.toLocaleDateString('es-MX', { weekday: 'short', day: 'numeric' })}, ${d.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' })}`;
                  return d.toLocaleDateString('es-MX', { day: 'numeric', month: 'short' });
                })()}
              </div>
            )}
          </div>
        </div>

        <div style={{ height: '180px', width: '100%', position: 'relative', zIndex: 10 }}>
          {loadingHist ? (
            <div style={{ height: '100%', display: 'flex', alignItems: 'center', justifyContent: 'center', transform: 'scale(0.8)' }}>
               <Loader label="Actualizando histórico..." />
            </div>
          ) : histData.length === 0 ? (
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', height: '100%', color: 'var(--text-muted)', fontSize: '12px' }}>
              Sin datos suficientes.
            </div>
          ) : (
            <ResponsiveContainer width="100%" height="100%">
              <AreaChart 
                data={histData} 
                margin={{ top: 10, right: 0, left: 0, bottom: 0 }}
                onMouseLeave={() => setActivePoint(null)}
              >
                <defs>
                  <linearGradient id="colorTotal" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="5%" stopColor={strokeColor} stopOpacity={0.4}/>
                    <stop offset="95%" stopColor={strokeColor} stopOpacity={0}/>
                  </linearGradient>
                </defs>
                <XAxis 
                  dataKey="timestamp" 
                  axisLine={false} 
                  tickLine={false} 
                  tick={{ fontSize: 10, fill: 'var(--text-muted)' }} 
                  minTickGap={30}
                  tickFormatter={(val) => {
                    const d = new Date(val * 1000);
                    if (range === '12h' || range === '1d') return d.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
                    if (range === '1w') {
                      const day = d.toLocaleDateString('es-MX', { weekday: 'short' });
                      return `${day.charAt(0).toUpperCase() + day.slice(1)} ${d.getDate()}`;
                    }
                    return d.toLocaleDateString('es-MX', { day: 'numeric', month: 'short' });
                  }}
                />
                <YAxis 
                  hide={false} 
                  domain={['auto', 'auto']} 
                  axisLine={false}
                  tickLine={false}
                  tickFormatter={(val) => formatConverted(val, 0)}
                  tick={{ fontSize: 10, fill: 'var(--text-muted)' }}
                  width={60}
                />
                <Tooltip 
                  cursor={{ stroke: 'rgba(255,255,255,0.2)', strokeWidth: 1, strokeDasharray: '3 3' }}
                  isAnimationActive={false}
                  content={<StateLifterTooltip setActivePoint={setActivePoint} />}
                />
                <Area 
                  type="monotone" 
                  dataKey="total" 
                  stroke={strokeColor} 
                  strokeWidth={2}
                  fillOpacity={1} 
                  fill="url(#colorTotal)" 
                  isAnimationActive={false}
                />
              </AreaChart>
            </ResponsiveContainer>
          )}
        </div>
      </div>

      {/* Barra de Distribución Minimalista */}
      { distData.length > 0 && (
        <div style={{ marginTop: '8px' }}>
          <div style={{ display: 'flex', width: '100%', height: '6px', borderRadius: '4px', overflow: 'hidden', marginBottom: '12px' }}>
            {distData.map(d => (
              <div key={d.name} style={{ width: `${(d.value / totalDist) * 100}%`, background: d.color }} />
            ))}
          </div>
          <div style={{ display: 'flex', flexWrap: 'wrap', gap: '16px' }}>
            {distData.map(d => (
              <div key={d.name} style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
                <div style={{ width: '8px', height: '8px', borderRadius: '50%', background: d.color }} />
                <div style={{ fontSize: '11px', color: 'var(--text-muted)' }}>{d.name}</div>
                <div style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text-primary)' }}>{((d.value / totalDist) * 100).toFixed(1)}%</div>
              </div>
            ))}
          </div>
        </div>
      )}

    </div>
  );
}
</file>

<file path="src/components/dashboard/ProfileModal.tsx">
'use client';

import { useState } from 'react';
import { motion } from 'motion/react';
import { X, User as UserIcon, Lock, Mail, Copy, CheckCircle2 } from 'lucide-react';
import { GlassCard } from '@/components/ui';
import { updateUserProfile, updateUserPassword } from '@/app/auth/actions';
import { useShortcutToken } from '@/lib/hooks';
import type { User } from '@supabase/supabase-js';
import { ExportarDatos } from '@/components/dashboard/ExportarDatos';
import { triggerHaptic } from '@/lib/ui/feedback';

interface ProfileModalProps {
  user: User;
  onClose: () => void;
  modo: string;
  setModo: (modo: 'diario' | 'patrimonio') => void;
}

export function ProfileModal({ user, onClose, modo, setModo }: ProfileModalProps) {
  const isGoogle = user.app_metadata?.providers?.includes('google') || user.app_metadata?.provider === 'google';
  
  const [name, setName] = useState(user.user_metadata?.full_name || '');
  const [password, setPassword] = useState('');
  
  const [editingName, setEditingName] = useState(false);
  const [editingPass, setEditingPass] = useState(false);
  
  const [loadingName, setLoadingName] = useState(false);
  const [loadingPass, setLoadingPass] = useState(false);
  
  const [errorMsg, setErrorMsg] = useState('');
  const [successMsg, setSuccessMsg] = useState('');
  const [copiedToken, setCopiedToken] = useState(false);

  const { data: shortcutToken, isLoading: tokenLoading } = useShortcutToken();

  const lastChange = user.user_metadata?.last_password_change;
  const daysSince = lastChange ? Math.floor((new Date().getTime() - new Date(lastChange).getTime()) / (1000 * 60 * 60 * 24)) : 999;
  const canChangePass = !isGoogle && daysSince >= 30;

  const handleUpdateName = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!name.trim()) return;
    setLoadingName(true);
    setErrorMsg('');
    setSuccessMsg('');
    try {
      const formData = new FormData();
      formData.append('name', name);
      await updateUserProfile(formData);
      setSuccessMsg('Nombre actualizado');
      setEditingName(false);
    } catch (err: Error | unknown) {
      setErrorMsg(err instanceof Error ? err.message : 'Error al actualizar nombre');
    } finally {
      setLoadingName(false);
    }
  };

  const handleUpdatePassword = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!password || password.length < 6) {
      setErrorMsg('La contraseña debe tener al menos 6 caracteres');
      return;
    }
    setLoadingPass(true);
    setErrorMsg('');
    setSuccessMsg('');
    try {
      const formData = new FormData();
      formData.append('password', password);
      await updateUserPassword(formData);
      setSuccessMsg('Contraseña actualizada correctamente');
      setEditingPass(false);
      setPassword('');
    } catch (err: Error | unknown) {
      setErrorMsg(err instanceof Error ? err.message : 'Error al actualizar contraseña');
    } finally {
      setLoadingPass(false);
    }
  };

  return (
    <div style={{ position: 'fixed', inset: 0, zIndex: 1000, display: 'flex', alignItems: 'center', justifyContent: 'center', padding: '20px' }}>
      <motion.div
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        onClick={onClose}
        style={{ position: 'absolute', inset: 0, background: 'rgba(0,0,0,0.6)', backdropFilter: 'blur(8px)' }}
      />
      
      <motion.div
        initial={{ opacity: 0, scale: 0.95, y: 20 }}
        animate={{ opacity: 1, scale: 1, y: 0 }}
        exit={{ opacity: 0, scale: 0.95, y: 20 }}
        style={{ width: '100%', maxWidth: '400px', position: 'relative' }}
      >
        <GlassCard style={{ padding: '24px' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '24px' }}>
            <h2 style={{ fontSize: '20px', fontWeight: 600, color: 'var(--text-primary)', margin: 0 }}>Perfil</h2>
            <button onClick={onClose} style={{ background: 'none', border: 'none', color: 'var(--text-muted)', cursor: 'pointer' }}>
              <X size={20} />
            </button>
          </div>

          {errorMsg && (
            <div style={{ background: 'rgba(239,68,68,0.1)', color: 'var(--credito-rojo)', padding: '12px', borderRadius: '8px', marginBottom: '16px', fontSize: '13px' }}>
              {errorMsg}
            </div>
          )}
          {successMsg && (
            <div style={{ background: 'rgba(74,222,128,0.1)', color: 'var(--credito-verde)', padding: '12px', borderRadius: '8px', marginBottom: '16px', fontSize: '13px' }}>
              {successMsg}
            </div>
          )}

          <div style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>
            {/* Email (Readonly) */}
            <div>
              <div style={{ fontSize: '13px', color: 'var(--text-muted)', marginBottom: '8px', display: 'flex', alignItems: 'center', gap: '6px' }}>
                <Mail size={14} /> Correo Electrónico
              </div>
              <div style={{ background: 'rgba(0,0,0,0.2)', padding: '12px', borderRadius: '8px', color: 'var(--text-secondary)', fontSize: '15px' }}>
                {user.email}
              </div>
            </div>

            {/* Nombre */}
            <div>
              <div style={{ fontSize: '13px', color: 'var(--text-muted)', marginBottom: '8px', display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                <span style={{ display: 'flex', alignItems: 'center', gap: '6px' }}><UserIcon size={14} /> Nombre</span>
                {!editingName && (
                  <button onClick={() => setEditingName(true)} style={{ background: 'none', border: 'none', color: 'var(--brand)', fontSize: '13px', cursor: 'pointer' }}>Editar</button>
                )}
              </div>
              
              {editingName ? (
                <form onSubmit={handleUpdateName} style={{ display: 'flex', gap: '8px' }}>
                  <input
                    value={name}
                    onChange={e => setName(e.target.value)}
                    style={{ flex: 1, background: 'rgba(0,0,0,0.3)', border: '1px solid var(--brand)', padding: '10px 12px', borderRadius: '8px', color: '#fff', fontSize: '15px' }}
                    autoFocus
                  />
                  <button type="submit" disabled={loadingName} style={{ background: 'var(--brand)', color: '#000', border: 'none', borderRadius: '8px', padding: '0 16px', fontWeight: 600 }}>
                    {loadingName ? '...' : 'Guardar'}
                  </button>
                </form>
              ) : (
                <div style={{ background: 'rgba(0,0,0,0.2)', padding: '12px', borderRadius: '8px', color: 'var(--text-primary)', fontSize: '15px' }}>
                  {user.user_metadata?.full_name || 'Sin nombre'}
                </div>
              )}
            </div>

            {/* Contraseña */}
            <div>
              <div style={{ fontSize: '13px', color: 'var(--text-muted)', marginBottom: '8px', display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                <span style={{ display: 'flex', alignItems: 'center', gap: '6px' }}><Lock size={14} /> Contraseña</span>
                {!editingPass && canChangePass && (
                  <button onClick={() => setEditingPass(true)} style={{ background: 'none', border: 'none', color: 'var(--brand)', fontSize: '13px', cursor: 'pointer' }}>Editar</button>
                )}
              </div>
              
              {isGoogle ? (
                <div style={{ background: 'rgba(0,0,0,0.2)', padding: '12px', borderRadius: '8px', color: 'var(--text-secondary)', fontSize: '14px' }}>
                  Registrado con Google (no editable)
                </div>
              ) : !canChangePass && !editingPass ? (
                <div style={{ background: 'rgba(0,0,0,0.2)', padding: '12px', borderRadius: '8px', color: 'var(--text-secondary)', fontSize: '14px' }}>
                  Actualizada hace {daysSince} días. <br/><span style={{fontSize:'12px', opacity:0.7}}>Solo 1 vez cada 30 días.</span>
                </div>
              ) : editingPass ? (
                <form onSubmit={handleUpdatePassword} style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
                  <input
                    type="password"
                    placeholder="Nueva contraseña"
                    value={password}
                    onChange={e => setPassword(e.target.value)}
                    style={{ background: 'rgba(0,0,0,0.3)', border: '1px solid var(--brand)', padding: '10px 12px', borderRadius: '8px', color: '#fff', fontSize: '15px' }}
                    autoFocus
                  />
                  <div style={{ display: 'flex', gap: '8px' }}>
                    <button type="button" onClick={() => setEditingPass(false)} style={{ flex: 1, background: 'rgba(255,255,255,0.1)', color: 'var(--text-primary)', border: 'none', borderRadius: '8px', padding: '10px' }}>
                      Cancelar
                    </button>
                    <button type="submit" disabled={loadingPass} style={{ flex: 1, background: 'var(--brand)', color: '#000', border: 'none', borderRadius: '8px', padding: '10px', fontWeight: 600 }}>
                      {loadingPass ? '...' : 'Guardar'}
                    </button>
                  </div>
                </form>
              ) : (
                <div style={{ background: 'rgba(0,0,0,0.2)', padding: '12px', borderRadius: '8px', color: 'var(--text-primary)', fontSize: '15px' }}>
                  ••••••••
                </div>
              )}
            </div>

            <hr style={{ border: 'none', borderTop: '1px solid rgba(255,255,255,0.1)', margin: '4px 0' }} />

            {/* Apple Shortcuts Token */}
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
              <div>
                <div style={{ fontWeight: 600, fontSize: '15px', color: 'var(--text-primary)' }}>Apple Shortcuts</div>
                <div style={{ fontSize: '13px', color: 'var(--text-muted)', marginTop: '2px' }}>Tu Token personal para la app Atajos</div>
              </div>
              <button 
                type="button"
                disabled={tokenLoading || !shortcutToken}
                onClick={() => {
                  if (shortcutToken) {
                    navigator.clipboard.writeText(shortcutToken);
                    setCopiedToken(true);
                    setTimeout(() => setCopiedToken(false), 2000);
                  }
                }}
                style={{
                  background: copiedToken ? 'rgba(34, 197, 94, 0.2)' : 'rgba(255,255,255,0.1)',
                  color: copiedToken ? '#4ade80' : 'var(--text-primary)',
                  border: 'none',
                  borderRadius: '8px',
                  padding: '8px 12px',
                  fontSize: '13px',
                  fontWeight: 600,
                  display: 'flex',
                  alignItems: 'center',
                  gap: '6px',
                  cursor: 'pointer',
                  transition: 'all 0.2s ease',
                }}
              >
                {tokenLoading ? 'Cargando...' : copiedToken ? <><CheckCircle2 size={16} /> Copiado</> : <><Copy size={16} /> Copiar Token</>}
              </button>
            </div>
            
            <div style={{ display: 'flex', gap: '8px', marginTop: '12px', flexWrap: 'wrap' }}>
              <a href="https://www.icloud.com/shortcuts/a93ee327b80a4ed2ada961a1e7ad8816" target="_blank" rel="noreferrer" style={{ fontSize: '12px', background: 'rgba(255,255,255,0.05)', color: 'var(--text-secondary)', padding: '4px 10px', borderRadius: '12px', textDecoration: 'none', border: '1px solid rgba(255,255,255,0.1)' }}>+ FinTrack</a>
              <a href="https://www.icloud.com/shortcuts/0ff04b22d2e94c64aa99aed6792658c5" target="_blank" rel="noreferrer" style={{ fontSize: '12px', background: 'rgba(255,255,255,0.05)', color: 'var(--text-secondary)', padding: '4px 10px', borderRadius: '12px', textDecoration: 'none', border: '1px solid rgba(255,255,255,0.1)' }}>+ Gasto</a>
              <a href="https://www.icloud.com/shortcuts/f32fd0e003444be1a0ffcce2ebe8ccff" target="_blank" rel="noreferrer" style={{ fontSize: '12px', background: 'rgba(255,255,255,0.05)', color: 'var(--text-secondary)', padding: '4px 10px', borderRadius: '12px', textDecoration: 'none', border: '1px solid rgba(255,255,255,0.1)' }}>+ Ingreso</a>
            </div>

            <hr style={{ border: 'none', borderTop: '1px solid rgba(255,255,255,0.1)', margin: '4px 0' }} />

            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
              <div>
                <div style={{ fontWeight: 600, fontSize: '15px', color: 'var(--text-primary)' }}>Exportar Datos</div>
                <div style={{ fontSize: '13px', color: 'var(--text-muted)', marginTop: '2px' }}>Descarga todos tus movimientos en TSV</div>
              </div>
              <ExportarDatos />
            </div>

            <hr style={{ border: 'none', borderTop: '1px solid rgba(255,255,255,0.1)', margin: '4px 0' }} />

            {/* Toggle Modo Patrimonial */}
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
              <div>
                <div style={{ fontWeight: 600, fontSize: '15px', color: 'var(--text-primary)' }}>Modo Patrimonial</div>
                <div style={{ fontSize: '13px', color: 'var(--text-muted)', marginTop: '2px' }}>Ver portafolio de inversiones</div>
              </div>
              <button 
                onClick={() => {
                  triggerHaptic('light');
                  setModo(modo === 'diario' ? 'patrimonio' : 'diario');
                  onClose();
                }}
                style={{
                  width: '44px',
                  height: '24px',
                  borderRadius: '12px',
                  background: modo === 'patrimonio' ? 'var(--brand)' : 'rgba(255,255,255,0.1)',
                  border: 'none',
                  position: 'relative',
                  cursor: 'pointer',
                  transition: 'background 0.3s'
                }}
              >
                <div style={{
                  width: '20px',
                  height: '20px',
                  borderRadius: '50%',
                  background: '#fff',
                  position: 'absolute',
                  top: '2px',
                  left: modo === 'patrimonio' ? '22px' : '2px',
                  transition: 'left 0.3s'
                }} />
              </button>
            </div>

          </div>
        </GlassCard>
      </motion.div>
    </div>
  );
}
</file>

<file path="src/components/dashboard/TarjetaFormModal.tsx">
'use client';

import { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'motion/react';
import { useMotionConfig } from '@/lib/motion/variants';
import { GlassCard } from '@/components/ui';
import type { NuevaTarjetaInput } from '@/lib/api-inputs';

interface TarjetaFormModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSubmit: (data: Partial<NuevaTarjetaInput>) => void;
  initialData?: Partial<NuevaTarjetaInput>;
  isPending?: boolean;
}

export function TarjetaFormModal({
  isOpen,
  onClose,
  onSubmit,
  initialData,
  isPending,
}: TarjetaFormModalProps) {
  const { modalTransition } = useMotionConfig();
  const [tipo, setTipo] = useState<'Crédito' | 'Débito'>(initialData?.tipo || 'Crédito');
  const [nombre, setNombre] = useState(initialData?.nombre || '');
  const [limite, setLimite] = useState(initialData?.limite?.toString() || '');
  const [diaCorte, setDiaCorte] = useState(initialData?.diaCorte?.toString() || '');
  const [diaPago, setDiaPago] = useState(initialData?.diaPago?.toString() || '');
  const [rendimientoAnual, setRendimientoAnual] = useState(initialData?.rendimientoAnual?.toString() || '');
  const [gastoInicialCiclo, setGastoInicialCiclo] = useState(initialData?.gastoInicialCiclo?.toString() || '');
  
  const isEditing = !!initialData;

  // Reset form when initialData changes
  useEffect(() => {
    if (isOpen) {
      // eslint-disable-next-line react-hooks/set-state-in-effect
      setTipo(initialData?.tipo || 'Crédito');
      setNombre(initialData?.nombre || '');
      setLimite(initialData?.limite?.toString() || '');
      setDiaCorte(initialData?.diaCorte?.toString() || '');
      setDiaPago(initialData?.diaPago?.toString() || '');
      setRendimientoAnual(initialData?.rendimientoAnual?.toString() || '');
      setGastoInicialCiclo(initialData?.gastoInicialCiclo?.toString() || '');
    }
  }, [isOpen, initialData]);

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    onSubmit({
      nombre,
      tipo,
      limite: parseFloat(limite),
      diaCorte: tipo === 'Crédito' ? parseInt(diaCorte, 10) : null,
      diaPago: tipo === 'Crédito' ? parseInt(diaPago, 10) : null,
      rendimientoAnual: tipo === 'Débito' ? (parseFloat(rendimientoAnual) || 0) : 0,
      gastoInicialCiclo: tipo === 'Crédito' ? (parseFloat(gastoInicialCiclo) || 0) : 0,
    });
  };

  return (
    <AnimatePresence>
      {isOpen && (
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          style={{
            position: 'fixed',
            inset: 0,
            zIndex: 100,
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            padding: '20px',
            background: 'rgba(0, 0, 0, 0.6)',
            backdropFilter: 'blur(4px)',
          }}
        >
          {/* Backdrop click to close */}
          <div style={{ position: 'absolute', inset: 0 }} onClick={onClose} />
          
          <GlassCard
            as="div" // No es necesario animar GlassCard nativamente si envolvemos aquí, pero motion.div está en GlassCard ya.
            style={{ width: '100%', maxWidth: '380px', padding: '24px', zIndex: 1 }}
            {...modalTransition}
          >
            <h2 style={{ fontFamily: 'var(--font-display)', fontSize: '18px', color: 'var(--text-primary)', marginBottom: '20px' }}>
              {initialData ? 'Editar Tarjeta' : 'Nueva Tarjeta'}
            </h2>

            <form onSubmit={handleSubmit} style={{ display: 'flex', flexDirection: 'column', gap: '14px' }}>
              <div>
                <label style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>Tipo de Tarjeta</label>
                <div style={{ display: 'flex', gap: '10px', marginTop: '6px' }}>
                  <button
                    type="button"
                    onClick={() => setTipo('Crédito')}
                    style={{
                      flex: 1, padding: '10px', borderRadius: '8px', cursor: 'pointer',
                      border: tipo === 'Crédito' ? '1px solid var(--brand)' : '1px solid var(--border-glass)',
                      background: tipo === 'Crédito' ? 'rgba(250, 104, 111, 0.1)' : 'rgba(255, 255, 255, 0.05)',
                      color: tipo === 'Crédito' ? 'var(--brand)' : 'var(--text-secondary)'
                    }}
                  >
                    Crédito
                  </button>
                  <button
                    type="button"
                    onClick={() => setTipo('Débito')}
                    style={{
                      flex: 1, padding: '10px', borderRadius: '8px', cursor: 'pointer',
                      border: tipo === 'Débito' ? '1px solid var(--brand)' : '1px solid var(--border-glass)',
                      background: tipo === 'Débito' ? 'rgba(250, 104, 111, 0.1)' : 'rgba(255, 255, 255, 0.05)',
                      color: tipo === 'Débito' ? 'var(--brand)' : 'var(--text-secondary)'
                    }}
                  >
                    Débito
                  </button>
                </div>
              </div>
              
              {/* Bloquear cambio de tipo si está editando */}
              {isEditing && (
                <div style={{ fontSize: '12px', color: 'var(--credito-amarillo)', marginTop: '-8px' }}>
                  El tipo de tarjeta no se puede cambiar tras su creación.
                </div>
              )}

              <div>
                <label style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>Nombre</label>
                <input
                  type="text" required placeholder={tipo === 'Crédito' ? "Ej. Nu Bank" : "Ej. Débito BBVA"}
                  value={nombre} onChange={e => setNombre(e.target.value)}
                  className="glass-input"
                />
              </div>

              {!(isEditing && tipo === 'Débito') && (
                <div>
                  <label style={{ fontSize: '13px', color: 'var(--text-secondary)', display: 'flex', alignItems: 'center', gap: '4px' }}>
                    {tipo === 'Crédito' ? 'Límite de Crédito (MXN)' : 'Saldo Inicial (MXN)'}
                  </label>
                  <input
                    type="number" required min={tipo === 'Crédito' ? "1" : "0"} step="0.01" placeholder={tipo === 'Crédito' ? "20000" : "5000"}
                    value={limite} onChange={e => setLimite(e.target.value)}
                    className="glass-input"
                  />
                </div>
              )}

              <AnimatePresence>
                {tipo === 'Crédito' && (
                  <motion.div
                    initial={{ height: 0, opacity: 0 }}
                    animate={{ height: 'auto', opacity: 1 }}
                    exit={{ height: 0, opacity: 0 }}
                    style={{ display: 'flex', gap: '14px', overflow: 'hidden' }}
                  >
                    <div style={{ flex: 1 }}>
                      <label style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>Día de Corte</label>
                      <input
                        type="number" required min="1" max="31" placeholder="15"
                        value={diaCorte} onChange={e => setDiaCorte(e.target.value)}
                        className="glass-input"
                      />
                    </div>
                    <div style={{ flex: 1 }}>
                      <label style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>Día de Pago</label>
                      <input
                        type="number" required min="1" max="31" placeholder="5"
                        value={diaPago} onChange={e => setDiaPago(e.target.value)}
                        className="glass-input"
                      />
                    </div>
                  </motion.div>
                )}
                {tipo === 'Crédito' && !isEditing && (
                  <motion.div
                    initial={{ height: 0, opacity: 0 }}
                    animate={{ height: 'auto', opacity: 1 }}
                    exit={{ height: 0, opacity: 0 }}
                    style={{ overflow: 'hidden' }}
                  >
                    <label style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>
                      Gasto acumulado previo en este corte (opcional)
                    </label>
                    <input
                      type="number" min="0" step="0.01" placeholder="Ej. 3500.00"
                      value={gastoInicialCiclo} onChange={e => setGastoInicialCiclo(e.target.value)}
                      className="glass-input"
                    />
                    <div style={{ fontSize: '11px', color: 'var(--text-muted)', marginTop: '4px', lineHeight: 1.3 }}>
                      Si ya usaste tu tarjeta en este ciclo, anota lo que llevas gastado para calibrar tu disponible al instante sin cargar compras pasadas.
                    </div>
                  </motion.div>
                )}
                {tipo === 'Débito' && (
                  <motion.div
                    initial={{ height: 0, opacity: 0 }}
                    animate={{ height: 'auto', opacity: 1 }}
                    exit={{ height: 0, opacity: 0 }}
                    style={{ overflow: 'hidden' }}
                  >
                    <label style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>Rendimiento Anual / TNA % (Opcional)</label>
                    <input
                      type="number" min="0" step="0.1" placeholder="Ej. 15.0"
                      value={rendimientoAnual} onChange={e => setRendimientoAnual(e.target.value)}
                      className="glass-input"
                    />
                  </motion.div>
                )}
              </AnimatePresence>

              <div style={{ display: 'flex', gap: '10px', marginTop: '10px' }}>
                <button
                  type="submit"
                  disabled={isPending}
                  style={{
                    flex: 1, padding: '12px', borderRadius: '10px', border: 'none',
                    background: 'var(--brand)', color: '#1a0a0b', fontWeight: 600,
                    cursor: 'pointer'
                  }}
                >
                  {isPending ? 'Guardando...' : 'Guardar'}
                </button>
                <button
                  type="button"
                  onClick={onClose}
                  style={{
                    flex: 1, padding: '12px', borderRadius: '10px',
                    background: 'rgba(255,255,255,0.06)', border: '1px solid var(--border-glass)',
                    color: 'var(--text-secondary)', cursor: 'pointer'
                  }}
                >
                  Cancelar
                </button>
              </div>
            </form>
          </GlassCard>
        </motion.div>
      )}
    </AnimatePresence>
  );
}
