<file path="src/app/dashboard/page.tsx">
'use client';

/**
 * Dashboard principal — Feature 1: Dashboard de Tarjetas (FR-09 a FR-14, FR-31).
 * Consume useTarjetas() + useComprasMSI() — NFR-06b.
 * Agrega CRUD completo de Tarjetas (Caveman style).
 */

import { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'motion/react';
import {
  DndContext,
  closestCenter,
  MouseSensor,
  TouchSensor,
  useSensor,
  useSensors,
  DragEndEvent,
} from '@dnd-kit/core';
import {
  SortableContext,
  arrayMove,
  rectSortingStrategy,
  verticalListSortingStrategy,
} from '@dnd-kit/sortable';
import { useTarjetas, useComprasMSI, useMetas, useCrearTarjeta, useActualizarTarjeta, useEliminarTarjeta, useMovimientos } from '@/lib/hooks';
import { calcularSaldoEfectivo } from '@/lib/finance/efectivo';
import { TarjetaCard } from '@/components/dashboard/TarjetaCard';
import { EfectivoCard } from '@/components/dashboard/EfectivoCard';

import { SortableTarjeta } from '@/components/dashboard/SortableTarjeta';
import { TarjetaFormModal } from '@/components/dashboard/TarjetaFormModal';
import { MovimientosTarjetaModal } from '@/components/dashboard/MovimientosTarjetaModal';
import { ApartadoFormModal } from '@/components/dashboard/ApartadoFormModal';
import { MoverDineroApartadoModal } from '@/components/dashboard/MoverDineroApartadoModal';
import { AjusteSaldoModal } from '@/components/dashboard/AjusteSaldoModal';
import { ImportarMovimientosModal } from '@/components/dashboard/ImportarMovimientosModal';
import { GlassCard } from '@/components/ui';
import { Plus, HelpCircle, LayoutGrid, List, Eye, EyeOff, UploadCloud } from 'lucide-react';
import type { TarjetaConEstado } from '@/lib/types';

export default function DashboardPage() {
  const { data: tarjetas, isLoading: loadT, error: errT } = useTarjetas();
  const { data: comprasMSI = [], isLoading: loadM } = useComprasMSI();
  const { data: metas = [] } = useMetas();
  const { data: movimientos = [] } = useMovimientos();
  
  const { mutate: crear } = useCrearTarjeta();
  const { mutate: actualizar } = useActualizarTarjeta();
  const { mutate: eliminar } = useEliminarTarjeta();

  const [modalOpen, setModalOpen] = useState(false);
  const [editingCard, setEditingCard] = useState<TarjetaConEstado | null>(null);
  const [viewingCard, setViewingCard] = useState<TarjetaConEstado | null>(null);
  const [apartadoCard, setApartadoCard] = useState<TarjetaConEstado | null>(null);
  const [moveApartado, setMoveApartado] = useState<{ id: string, maxRetiro: number, maxIngreso: number } | null>(null);
  const [ajustandoTarjeta, setAjustandoTarjeta] = useState<TarjetaConEstado | null>(null);
  const [importModalOpen, setImportModalOpen] = useState(false);
  
  const [showFlags, setShowFlags] = useState(true);
  const [viewMode, setViewMode] = useState<'full' | 'compact'>('full');
  const [infoModalOpen, setInfoModalOpen] = useState(false);
  const [cardOrder, setCardOrder] = useState<string[]>([]);
  const [isEditingOrder, setIsEditingOrder] = useState(false);
  const [showBalances, setShowBalances] = useState(true);

  const sensors = useSensors(
    useSensor(MouseSensor, {
      activationConstraint: { distance: 5 },
    }),
    useSensor(TouchSensor, {
      activationConstraint: { delay: 100, tolerance: 5 },
    })
  );

  useEffect(() => {
    const savedFlags = localStorage.getItem('fintrack_show_flags');
    if (savedFlags !== null) {
      // eslint-disable-next-line react-hooks/set-state-in-effect
      setShowFlags(savedFlags === 'true');
    }
    const savedView = localStorage.getItem('fintrack_card_view_mode');
    if (savedView === 'compact' || savedView === 'full') {
      setViewMode(savedView);
    }
    const savedBalances = localStorage.getItem('fintrack_show_balances');
    if (savedBalances !== null) {
      setShowBalances(savedBalances === 'true');
    }
  }, []);

  useEffect(() => {
    if (tarjetas) {
      const savedOrder = localStorage.getItem('fintrack_card_order');
      let parsed: string[] = [];
      if (savedOrder) {
        try { parsed = JSON.parse(savedOrder); } catch {}
      }
      const existingIds = new Set(tarjetas.map(t => t.id));
      existingIds.add('efectivo');
      const validOrder = parsed.filter(id => existingIds.has(id));
      const missingIds = ['efectivo', ...tarjetas.map(t => t.id)].filter(id => !validOrder.includes(id));
      
      const newOrder = [...validOrder, ...missingIds];
      // Only set if different to avoid unnecessary renders
      if (newOrder.join(',') !== cardOrder.join(',')) {
        // eslint-disable-next-line react-hooks/set-state-in-effect
        setCardOrder(newOrder);
      }
    }
  }, [tarjetas, cardOrder]);

  const handleDragEnd = (event: DragEndEvent) => {
    const { active, over } = event;
    if (over && active.id !== over.id) {
      setCardOrder((items) => {
        const oldIndex = items.indexOf(active.id as string);
        const newIndex = items.indexOf(over.id as string);
        const newOrder = arrayMove(items, oldIndex, newIndex);
        localStorage.setItem('fintrack_card_order', JSON.stringify(newOrder));
        return newOrder;
      });
    }
  };

  const toggleFlags = () => {
    setShowFlags((prev) => {
      const next = !prev;
      localStorage.setItem('fintrack_show_flags', String(next));
      return next;
    });
  };

  const isLoading = loadT || loadM;

  const handleOpenModal = (tarjeta?: TarjetaConEstado) => {
    if (tarjeta) {
      setEditingCard(tarjeta);
    } else {
      setEditingCard(null);
      setModalOpen(true);
    }
  };

  return (
    <main>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '20px' }}>
        <h1 id="title-tarjetas" style={{
          fontFamily: 'var(--font-display)',
          fontWeight: 500,
          fontSize: '26px',
          letterSpacing: '-0.02em',
          color: 'var(--text-primary)',
        }}>
          Tus tarjetas
        </h1>

        <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
          {isEditingOrder && (
            <button
              onClick={() => setIsEditingOrder(false)}
              style={{
                background: 'var(--brand)', border: 'none', color: '#fff',
                cursor: 'pointer', padding: '6px 14px', borderRadius: '16px',
                fontSize: '13px', fontWeight: 600,
              }}
            >
              Hecho
            </button>
          )}

          <button
            onClick={() => {
              setViewMode((prev) => {
                const next = prev === 'full' ? 'compact' : 'full';
                localStorage.setItem('fintrack_card_view_mode', next);
                return next;
              });
            }}
            style={{
              background: 'rgba(255,255,255,0.1)', border: 'none', color: 'var(--text-primary)',
              cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center',
              width: '32px', height: '32px', borderRadius: '50%',
              transition: 'background 0.2s',
            }}
            aria-label="Cambiar vista de tarjetas"
          >
            {viewMode === 'full' ? <LayoutGrid size={16} /> : <List size={16} />}
          </button>

          <button
            onClick={() => {
              setShowBalances((prev) => {
                const next = !prev;
                localStorage.setItem('fintrack_show_balances', String(next));
                return next;
              });
            }}
            style={{
              background: 'rgba(255,255,255,0.1)', border: 'none', color: 'var(--text-primary)',
              cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center',
              width: '32px', height: '32px', borderRadius: '50%',
              transition: 'background 0.2s',
            }}
            aria-label="Ocultar saldos"
          >
            {showBalances ? <Eye size={16} /> : <EyeOff size={16} />}
          </button>

          <button
            onClick={() => setInfoModalOpen(true)}
            style={{
              background: 'none', border: 'none', color: 'var(--text-muted)',
              cursor: 'pointer', display: 'flex', alignItems: 'center'
            }}
            aria-label="Info de banderas de gasto"
          >
            <HelpCircle size={18} />
          </button>
          
          <button
            onClick={toggleFlags}
            style={{
              background: showFlags ? 'var(--brand)' : 'rgba(255,255,255,0.1)',
              border: 'none',
              borderRadius: '20px',
              width: '40px',
              height: '22px',
              position: 'relative',
              cursor: 'pointer',
              transition: 'background 0.3s'
            }}
            aria-label="Activar banderas de gasto"
          >
            <motion.div
              animate={{ x: showFlags ? 18 : 2 }}
              transition={{ type: 'spring', stiffness: 500, damping: 30 }}
              style={{
                width: '18px',
                height: '18px',
                background: '#fff',
                borderRadius: '50%',
                boxShadow: '0 2px 4px rgba(0,0,0,0.2)',
                position: 'absolute',
                top: '2px',
                left: 0
              }}
            />
          </button>
        </div>
      </div>

      {isLoading && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
          {[1, 2].map((i) => (
            <div
              key={i}
              style={{
                height: '200px',
                borderRadius: '22px',
                background: 'var(--surface-glass)',
                border: '1px solid var(--border-glass)',
                animation: 'pulse 1.5s ease-in-out infinite',
              }}
            />
          ))}
        </div>
      )}

      {errT && (
        <GlassCard glow="rojo" style={{ padding: '20px' }}>
          <p style={{ color: 'var(--credito-rojo)', fontSize: '14px' }}>
            Error al cargar tarjetas: {errT.message}
          </p>
        </GlassCard>
      )}

      {!isLoading && !errT && tarjetas && (
        <>
          {tarjetas.length === 0 ? (
            <GlassCard style={{ padding: '40px 24px', textAlign: 'center', marginBottom: '20px' }}>
              <p style={{ color: 'var(--text-muted)', fontSize: '14px' }}>
                Aún no tienes tarjetas. Agrega una para comenzar.
              </p>
            </GlassCard>
          ) : (
            <DndContext
              sensors={sensors}
              collisionDetection={closestCenter}
              onDragEnd={handleDragEnd}
            >
              <SortableContext
                items={cardOrder}
                strategy={viewMode === 'compact' ? rectSortingStrategy : verticalListSortingStrategy}
              >
                <div style={viewMode === 'compact' ? {
                  display: 'grid',
                  gridTemplateColumns: 'repeat(auto-fill, minmax(140px, 1fr))',
                  gap: '16px',
                  marginBottom: '20px'
                } : {
                  display: 'flex', flexDirection: 'column', gap: '16px', marginBottom: '20px'
                }}>
                  {cardOrder.map((id) => {
                    if (id === 'efectivo') {
                      return (
                        <SortableTarjeta 
                          key="efectivo" 
                          id="efectivo"
                          isEditing={isEditingOrder}
                          onLongPress={() => setIsEditingOrder(true)}
                        >
                          <EfectivoCard 
                            saldo={calcularSaldoEfectivo(movimientos)} 
                            variant={viewMode}
                            showBalance={showBalances}
                            onClick={() => setViewingCard({
                              id: 'efectivo',
                              nombre: 'Efectivo',
                              tipo: 'Débito', // Fake tipo para omitir lógicas de crédito
                              disponible: calcularSaldoEfectivo(movimientos),
                              limite: 0,
                              marca: 'Mastercard',
                              color: 'blue'
                            } as unknown as TarjetaConEstado)}
                          />
                        </SortableTarjeta>
                      );
                    }

                    const t = tarjetas.find(card => card.id === id);
                    if (!t) return null;
                    return (
                      <SortableTarjeta 
                        key={t.id} 
                        id={t.id}
                        isEditing={isEditingOrder}
                        onLongPress={() => setIsEditingOrder(true)}
                      >
                        <TarjetaCard
                          tarjeta={t}
                          comprasMSI={comprasMSI.filter((m) => m.tarjetaId === t.id)}
                          metas={metas}
                          showFlags={showFlags}
                          variant={viewMode}
                          showBalance={showBalances}
                          onEdit={(t) => setEditingCard(t)}
                          onDelete={eliminar}
                          onViewDetails={(t) => setViewingCard(t)}
                          onAddApartado={(t) => setApartadoCard(t)}
                          onMoveApartado={(id, maxRetiro, maxIngreso) => setMoveApartado({ id, maxRetiro, maxIngreso })}
                          onAjustarSaldo={(t) => setAjustandoTarjeta(t)}
                        />
                      </SortableTarjeta>
                    );
                  })}
                </div>
              </SortableContext>
            </DndContext>
          )}

          {/* Botón Agregar Tarjeta */}
          <div style={{ display: 'flex', gap: '16px' }}>
            <GlassCard
              id="btn-add-card"
              as="button"
              onClick={() => handleOpenModal()}
              style={{
                flex: 1,
                padding: '24px',
                borderStyle: 'dashed',
                background: 'transparent',
                color: 'var(--text-secondary)',
                cursor: 'pointer',
                fontSize: '15px',
              }}
            >
              <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '8px' }}>
                <Plus size={18} />
                <span>Agregar tarjeta</span>
              </div>
            </GlassCard>

            <GlassCard
              as="button"
              onClick={() => setImportModalOpen(true)}
              style={{
                flex: 1,
                padding: '24px',
                borderStyle: 'dashed',
                background: 'transparent',
                color: 'var(--text-secondary)',
                cursor: 'pointer',
                fontSize: '15px',
              }}
            >
              <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '8px' }}>
                <UploadCloud size={18} />
                <span>Importar CSV</span>
              </div>
            </GlassCard>
          </div>

          {/* Sección Salud Financiera */}

        </>
      )}

      {/* Modales */}
      <TarjetaFormModal
        isOpen={modalOpen || editingCard !== null}
        onClose={() => { setModalOpen(false); setEditingCard(null); }}
        initialData={editingCard || undefined}
        onSubmit={(datos) => {
          if (editingCard) {
            actualizar({ id: editingCard.id, campos: datos });
          } else {
            crear(datos as unknown as import('@/lib/api-inputs').NuevaTarjetaInput);
          }
          setModalOpen(false);
          setEditingCard(null);
        }}
      />

      <ApartadoFormModal
        isOpen={apartadoCard !== null}
        onClose={() => setApartadoCard(null)}
        tarjeta={apartadoCard}
      />

      <MoverDineroApartadoModal
        isOpen={moveApartado !== null}
        onClose={() => setMoveApartado(null)}
        apartadoId={moveApartado?.id || null}
        maxRetiro={moveApartado?.maxRetiro || 0}
        maxIngreso={moveApartado?.maxIngreso || 0}
      />

      <AjusteSaldoModal
        isOpen={ajustandoTarjeta !== null}
        onClose={() => setAjustandoTarjeta(null)}
        tarjeta={ajustandoTarjeta}
      />

      <ImportarMovimientosModal
        isOpen={importModalOpen}
        onClose={() => setImportModalOpen(false)}
      />

      {/* Modal Detalles */}
      <MovimientosTarjetaModal
        tarjeta={viewingCard}
        onClose={() => setViewingCard(null)}
      />

      {/* Modal de Información de Banderas */}
      <AnimatePresence>
        {infoModalOpen && (
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            style={{
              position: 'fixed',
              inset: 0,
              zIndex: 100,
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              padding: '20px',
              background: 'rgba(0, 0, 0, 0.6)',
              backdropFilter: 'blur(4px)',
            }}
          >
            <div style={{ position: 'absolute', inset: 0 }} onClick={() => setInfoModalOpen(false)} />
            
            <GlassCard style={{ width: '100%', maxWidth: '380px', padding: '24px', zIndex: 1, position: 'relative' }}>
              <h2 style={{ fontFamily: 'var(--font-display)', fontSize: '18px', color: 'var(--text-primary)', marginBottom: '20px' }}>
                Banderas de Gasto
              </h2>
              <div style={{ display: 'flex', flexDirection: 'column', gap: '16px', fontSize: '14px', color: 'var(--text-secondary)', lineHeight: '1.5' }}>
                <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
                  <div style={{ width: '12px', height: '12px', borderRadius: '50%', background: 'var(--credito-verde)' }} />
                  <div><strong>Rango ideal (0% - 30%)</strong><br/>Uso óptimo de la tarjeta.</div>
                </div>
                <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
                  <div style={{ width: '12px', height: '12px', borderRadius: '50%', background: 'var(--credito-amarillo)' }} />
                  <div><strong>Controla tus gastos (30% - 80%)</strong><br/>Precaución al endeudarte más.</div>
                </div>
                <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
                  <div style={{ width: '12px', height: '12px', borderRadius: '50%', background: 'var(--credito-rojo)' }} />
                  <div><strong>Cuidado (&gt;80%)</strong><br/>Alto nivel de deuda.</div>
                </div>
              </div>
              <button
                onClick={() => setInfoModalOpen(false)}
                style={{
                  width: '100%', marginTop: '24px', padding: '12px', borderRadius: '10px',
                  background: 'rgba(255,255,255,0.06)', border: '1px solid var(--border-glass)',
                  color: 'var(--text-primary)', cursor: 'pointer'
                }}
              >
                Entendido
              </button>
            </GlassCard>
          </motion.div>
        )}
      </AnimatePresence>

      <style>{`
        @keyframes pulse {
          0%, 100% { opacity: 0.4; }
          50% { opacity: 0.7; }
        }
      `}</style>
    </main>
  );
}
</file>

<file path="src/components/dashboard/TarjetaCard.tsx">
'use client';

/**
 * TarjetaCard — FR-09 a FR-14 + FR-31.
 * Muestra el termómetro de crédito de una tarjeta con GlassCard + StatusPill.
 * Incluye sección expandible de compras MSI activas de esa tarjeta (FR-31).
 *
 * Toda la data viene del hook useTarjetas() + useComprasMSI() —
 * NFR-06b: ningún fetch directo aquí.
 */

import { useState, useEffect, useRef } from 'react';
import { GlassCard, StatusPill, ConfirmModal } from '@/components/ui';
import type { TarjetaConEstado, CompraMSI, MetaConEstado } from '@/lib/types';
import { Pencil, Trash, ArrowRightLeft, FastForward, RefreshCcw } from 'lucide-react';
import { useAdelantarCompraMSI } from '@/lib/hooks';

/* Formatea monto MXN (es-MX, formato moneda sin decimales si son .00) */
const fmt = new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: 'MXN',
  minimumFractionDigits: 0,
  maximumFractionDigits: 2,
});

/* Formatea fecha YYYY-MM-DD → dd/mm/aaaa */
function fmtFecha(iso: string): string {
  const [y, m, d] = iso.split('-');
  return `${d}/${m}/${y}`;
}

interface TarjetaCardProps {
  tarjeta: TarjetaConEstado;
  comprasMSI: CompraMSI[];
  metas?: MetaConEstado[];
  showFlags?: boolean;
  variant?: 'full' | 'compact';
  showBalance?: boolean;
  onEdit?: (tarjeta: TarjetaConEstado) => void;
  onDelete?: (tarjetaId: string) => void;
  onViewDetails?: (tarjeta: TarjetaConEstado) => void;
  onAddApartado?: (tarjeta: TarjetaConEstado) => void;
  onMoveApartado?: (apartadoId: string, maxRetiro: number, maxIngreso: number) => void;
  onAjustarSaldo?: (tarjeta: TarjetaConEstado) => void;
}

export function TarjetaCard({ tarjeta, comprasMSI, metas = [], showFlags = true, variant = 'full', showBalance = true, onEdit, onDelete, onViewDetails, onAddApartado, onMoveApartado, onAjustarSaldo }: TarjetaCardProps) {
  const [msiOpen, setMsiOpen] = useState(false);
  const [metasOpen, setMetasOpen] = useState(false);
  const [apartadosOpen, setApartadosOpen] = useState(false);
  const [showDeleteConfirm, setShowDeleteConfirm] = useState(false);
  const [adelantarMSI, setAdelantarMSI] = useState<string | null>(null);
  const [adelantarMeses, setAdelantarMeses] = useState(1);
  const [adelantarDescuento, setAdelantarDescuento] = useState(0);

  // Efecto Tilt 3D
  const cardRef = useRef<HTMLElement>(null);
  const [glarePos, setGlarePos] = useState({ x: 50, y: 50, opacity: 0 });

  useEffect(() => {
    const handleOrientation = (e: DeviceOrientationEvent) => {
      if (e.gamma !== null && e.beta !== null) {
        // gamma: izquierda/derecha (-90 a 90)
        // beta: adelante/atrás (-180 a 180)
        const x = Math.min(Math.max((e.gamma + 90) / 1.8, 0), 100);
        const y = Math.min(Math.max((e.beta + 90) / 1.8, 0), 100);
        setGlarePos({ x, y, opacity: 0.15 });
      }
    };

    if (typeof window !== 'undefined' && window.DeviceOrientationEvent) {
      window.addEventListener('deviceorientation', handleOrientation);
    }
    return () => {
      if (typeof window !== 'undefined' && window.DeviceOrientationEvent) {
        window.removeEventListener('deviceorientation', handleOrientation);
      }
    };
  }, []);

  const handleMouseMove = (e: React.MouseEvent<HTMLElement>) => {
    if (!cardRef.current) return;
    const rect = cardRef.current.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;
    setGlarePos({ x, y, opacity: 0.2 });
  };

  const handleMouseLeave = () => {
    setGlarePos(prev => ({ ...prev, opacity: 0 }));
  };

  const { mutate: adelantar, isPending: isAdelantando } = useAdelantarCompraMSI();

  const msiActivas = comprasMSI.filter((m) => m.mesesRestantes > 0);
  const esCredito = tarjeta.tipo === 'Crédito';
  const apartados = tarjeta.apartados || [];

  let totalAportado = 0;
  const desgloseMetas: { metaNombre: string; monto: number; id: string }[] = [];

  if (!esCredito && metas.length > 0) {
    metas.forEach(meta => {
      let aportadoAEstaMeta = 0;
      meta.aportes.forEach(aporte => {
        if (aporte.tarjetaOrigenId === tarjeta.id) {
          aportadoAEstaMeta += aporte.monto;
          totalAportado += aporte.monto;
        }
      });
      if (aportadoAEstaMeta > 0) {
        desgloseMetas.push({ metaNombre: meta.nombre, monto: aportadoAEstaMeta, id: meta.id });
      }
    });
  }

  return (
    <GlassCard
      ref={cardRef}
      glow={(!showFlags || !esCredito) ? 'none' : tarjeta.estadoTermometro === 'verde' ? 'none' : tarjeta.estadoTermometro}
      as="article"
      style={{ 
        padding: variant === 'compact' ? '16px' : '24px', 
        cursor: onViewDetails ? 'pointer' : 'default',
        height: '100%',
        display: 'flex',
        flexDirection: 'column',
        position: 'relative',
        overflow: 'hidden'
      }}
      onClick={() => onViewDetails?.(tarjeta)}
      onMouseMove={handleMouseMove}
      onMouseLeave={handleMouseLeave}
    >
      {/* Tilt Specular Reflection */}
      <div style={{
        position: 'absolute',
        inset: 0,
        background: `radial-gradient(circle at ${glarePos.x}% ${glarePos.y}%, rgba(255, 255, 255, 0.4), transparent 60%)`,
        opacity: glarePos.opacity,
        pointerEvents: 'none',
        transition: 'opacity 0.3s ease',
        zIndex: 0
      }} />
      <div style={{ position: 'relative', zIndex: 1, display: 'flex', flexDirection: 'column', height: '100%' }}>
      {/* Cabecera: nombre + chip decorativo */}
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: variant === 'compact' ? '16px' : '28px' }}>
        <span style={{
          fontFamily: 'var(--font-display)',
          fontWeight: 500,
          fontSize: variant === 'compact' ? '15px' : '16px',
          color: 'var(--text-primary)',
          whiteSpace: 'nowrap',
          overflow: 'hidden',
          textOverflow: 'ellipsis',
          maxWidth: '85%'
        }}>
          {tarjeta.nombre}
        </span>
        {variant !== 'compact' && (
          <div style={{ display: 'flex', gap: '8px' }}>
            {onEdit && (
              <button
                onClick={(e) => { e.stopPropagation(); onEdit(tarjeta); }}
                aria-label="Editar tarjeta"
                style={{ background: 'none', border: 'none', color: 'var(--text-muted)', cursor: 'pointer', padding: '4px' }}
              >
                <Pencil size={16} />
              </button>
            )}
            {!esCredito && onAjustarSaldo && (
              <button
                onClick={(e) => { e.stopPropagation(); onAjustarSaldo(tarjeta); }}
                aria-label="Ajustar saldo"
                title="Ajustar saldo"
                style={{ background: 'none', border: 'none', color: 'var(--text-muted)', cursor: 'pointer', padding: '4px' }}
              >
                <RefreshCcw size={16} />
              </button>
            )}
            {onDelete && (
              <button
                onClick={(e) => {
                  e.stopPropagation();
                  setShowDeleteConfirm(true);
                }}
                aria-label="Eliminar tarjeta"
                style={{ background: 'none', border: 'none', color: 'var(--text-muted)', cursor: 'pointer', padding: '4px' }}
              >
                <Trash size={16} />
              </button>
            )}
          </div>
        )}
      </div>

      <div style={{ marginTop: 'auto', display: 'flex', flexDirection: 'column' }}>

      {showDeleteConfirm && (
        <ConfirmModal
          isOpen={true}
          title="Eliminar Tarjeta"
          message={`¿Estás seguro de eliminar la tarjeta ${tarjeta.nombre}? Esta acción no se puede deshacer y borrará todos sus datos asociados si no están respaldados.`}
          confirmText="Eliminar"
          cancelText="Cancelar"
          isDestructive
          onConfirm={() => {
            onDelete?.(tarjeta.id);
            setShowDeleteConfirm(false);
          }}
          onCancel={() => setShowDeleteConfirm(false)}
        />
      )}

      {adelantarMSI && (
        <ConfirmModal
          isOpen={true}
          title="Adelantar Mensualidades"
          message={
            <div style={{ display: 'flex', flexDirection: 'column', gap: '12px', marginTop: '12px' }}>
              <label style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>
                ¿Cuántos meses deseas adelantar?
                <input 
                  type="number" 
                  min="1" 
                  max="48"
                  value={adelantarMeses}
                  onChange={(e) => setAdelantarMeses(Number(e.target.value))}
                  style={{ width: '100%', padding: '10px', marginTop: '4px', background: 'rgba(0,0,0,0.3)', border: '1px solid rgba(255,255,255,0.1)', color: 'white', borderRadius: '8px' }}
                />
              </label>
              <label style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>
                Descuento ofrecido por el banco (MXN, opcional)
                <input 
                  type="number" 
                  min="0"
                  step="0.01"
                  value={adelantarDescuento}
                  onChange={(e) => setAdelantarDescuento(Number(e.target.value))}
                  style={{ width: '100%', padding: '10px', marginTop: '4px', background: 'rgba(0,0,0,0.3)', border: '1px solid rgba(255,255,255,0.1)', color: 'white', borderRadius: '8px' }}
                />
              </label>
            </div>
          }
          confirmText={isAdelantando ? "Guardando..." : "Confirmar Adelanto"}
          cancelText="Cancelar"
          onConfirm={() => {
            adelantar({ id: adelantarMSI, meses: adelantarMeses, descuento: adelantarDescuento }, {
              onSuccess: () => setAdelantarMSI(null)
            });
          }}
          onCancel={() => setAdelantarMSI(null)}
        />
      )}

      {/* Fila inferior: disponible + pill */}
      <div style={{ 
        display: 'flex', 
        justifyContent: variant === 'compact' ? 'flex-start' : 'space-between', 
        alignItems: variant === 'compact' ? 'flex-start' : 'flex-end',
        flexDirection: variant === 'compact' ? 'column' : 'row',
        gap: variant === 'compact' ? '6px' : '0'
      }}>
        <div>
          <div style={{
            fontSize: '11px',
            textTransform: 'uppercase',
            letterSpacing: '0.06em',
            color: 'var(--text-muted)',
            marginBottom: '4px',
          }}>
            {esCredito ? 'Disponible' : 'Saldo actual'}
          </div>
          <div style={{
            fontFamily: 'var(--font-mono)',
            fontWeight: 700,
            fontSize: variant === 'compact' ? '18px' : '22px',
            color: !esCredito && tarjeta.disponible < 0 ? 'var(--credito-rojo)' : 'var(--text-primary)',
            fontVariantNumeric: 'tabular-nums',
            display: 'flex',
            alignItems: 'center',
            gap: '8px'
          }}>
            {showBalance ? fmt.format(tarjeta.disponible) : '••••••••'}
          </div>
        </div>

        {showFlags && esCredito && variant === 'full' && (
          <StatusPill
            mode="thermometer"
            variant={tarjeta.estadoTermometro}
            label={tarjeta.etiquetaEstado}
          />
        )}
        {showFlags && esCredito && variant === 'compact' && (
          <div style={{
            fontSize: '12px',
            fontWeight: 600,
            color: tarjeta.estadoTermometro === 'verde'
                  ? 'var(--credito-verde)'
                  : tarjeta.estadoTermometro === 'amarillo'
                  ? 'var(--credito-amarillo)'
                  : 'var(--credito-rojo)',
          }}>
            {tarjeta.porcentajeUso.toFixed(0)}% uso
          </div>
        )}
        {showFlags && !esCredito && tarjeta.disponible < 0 && variant === 'full' && (
          <StatusPill
            mode="thermometer"
            variant="rojo"
            label="Sobregiro"
          />
        )}
        {showFlags && !esCredito && tarjeta.disponible < 0 && variant === 'compact' && (
          <div style={{ fontSize: '12px', fontWeight: 600, color: 'var(--credito-rojo)' }}>
            Sobregiro
          </div>
        )}
        {!esCredito && tarjeta.rendimientoAnual > 0 && tarjeta.disponible >= 0 && variant === 'full' && (
          <StatusPill
            mode="thermometer"
            variant="verde"
            label={`${tarjeta.rendimientoAnual}% rendimientos`}
          />
        )}
        {!esCredito && tarjeta.rendimientoAnual > 0 && tarjeta.disponible >= 0 && variant === 'compact' && (
          <div style={{ fontSize: '12px', fontWeight: 600, color: 'var(--credito-verde)' }}>
            {tarjeta.rendimientoAnual}% rendimientos
          </div>
        )}
      </div>

      {/* Solo Crédito: Termómetro visual y Desglose */}
      {esCredito && (
        <>
          <div style={{ marginTop: variant === 'compact' ? '12px' : '20px' }}>
            <div style={{
              height: '4px',
              borderRadius: '2px',
              background: 'rgba(255,255,255,0.08)',
              overflow: 'hidden',
            }}>
              <div style={{
                height: '100%',
                width: `${Math.min(tarjeta.porcentajeUso, 100)}%`,
                background: tarjeta.estadoTermometro === 'verde'
                  ? 'var(--credito-verde)'
                  : tarjeta.estadoTermometro === 'amarillo'
                  ? 'var(--credito-amarillo)'
                  : 'var(--credito-rojo)',
                borderRadius: '2px',
                transition: 'width 0.6s ease',
              }} />
            </div>
            {variant === 'full' && (
              <div style={{
                display: 'flex',
                justifyContent: 'space-between',
                marginTop: '6px',
                fontSize: '11px',
                color: 'var(--text-muted)',
              }}>
                <span>{tarjeta.porcentajeUso.toFixed(1)}% del límite</span>
                <span>Pago: {tarjeta.proximoPago ? fmtFecha(tarjeta.proximoPago) : ''} ({tarjeta.diasParaPago}d)</span>
              </div>
            )}
          </div>

          {variant === 'full' && (
            <div style={{
              display: 'flex',
              justifyContent: 'space-between',
              marginTop: '14px',
              padding: '12px 0 0',
              borderTop: '1px solid rgba(255,255,255,0.06)',
              fontSize: '12px',
              color: 'var(--text-secondary)',
            }}>
              <span>Gastado: <strong style={{ fontFamily: 'var(--font-mono)', color: 'var(--text-primary)' }}>{fmt.format(tarjeta.gastosPeriodoActual)}</strong></span>
              <span>Límite: <strong style={{ fontFamily: 'var(--font-mono)', color: 'var(--text-primary)' }}>{fmt.format(tarjeta.limite)}</strong></span>
            </div>
          )}
        </>
      )}

      {/* Spacer para Débito en modo compacto para igualar altura con Crédito */}
      {!esCredito && variant === 'compact' && (
        <div style={{ marginTop: '12px', height: '4px' }} />
      )}

      {/* Sección MSI expandible — FR-31 */}
      {variant === 'full' && msiActivas.length > 0 && (
        <div style={{ marginTop: '14px' }}>
          <button
            onClick={(e) => { e.stopPropagation(); setMsiOpen((v) => !v); }}
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: '6px',
              background: 'none',
              border: 'none',
              color: 'var(--text-secondary)',
              fontSize: '12px',
              cursor: 'pointer',
              padding: 0,
            }}
          >
            <span style={{
              display: 'inline-block',
              transform: msiOpen ? 'rotate(90deg)' : 'rotate(0deg)',
              transition: 'transform 0.2s ease',
            }}>▶</span>
            {msiActivas.length} MSI activa{msiActivas.length !== 1 ? 's' : ''}
          </button>

          {msiOpen && (
            <div style={{ marginTop: '10px', display: 'flex', flexDirection: 'column', gap: '8px' }}>
              {msiActivas.map((msi) => (
                <div
                  key={msi.id}
